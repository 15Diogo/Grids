int OnInit()
{
   trade.SetExpertMagicNumber(Magic_Number);
   trade.SetDeviationInPoints(10);
   
   ENUM_SYMBOL_TRADE_EXECUTION exe_mode = (ENUM_SYMBOL_TRADE_EXECUTION)SymbolInfoInteger(_Symbol, SYMBOL_TRADE_EXEMODE);
   
   if(exe_mode == SYMBOL_TRADE_EXECUTION_EXCHANGE || exe_mode == SYMBOL_TRADE_EXECUTION_INSTANT)
      trade.SetTypeFilling(ORDER_FILLING_RETURN);
   else
      trade.SetTypeFilling(ORDER_FILLING_FOK);
   
   balance_inicial = AccountInfoDouble(ACCOUNT_BALANCE);
   capital_inicial_sessao = AccountInfoDouble(ACCOUNT_EQUITY);
   hora_inicio_sessao = TimeCurrent();
   
   rsi_rapido_handle = iRSI(_Symbol, RSI_Timeframe, RSI_Rapido_Periodo, RSI_Preco);
   rsi_lento_handle  = iRSI(_Symbol, RSI_Timeframe, RSI_Lento_Periodo, RSI_Preco);
   ma_handle         = iMA(_Symbol, MA_Timeframe, MA_Periodo, 0, MA_Metodo, MA_Preco);
   
   if(rsi_rapido_handle == INVALID_HANDLE || rsi_lento_handle == INVALID_HANDLE || ma_handle == INVALID_HANDLE)
   {
      Print("❌ ERRO: Falha ao criar os indicadores.");
      return(INIT_FAILED);
   }
   
   PAINEL_ALTURA = Mostrar_Botao_Reset ? 465 : 435;
   
   AdicionarIndicadoresNoGrafico();
   CriarPainelModerno();
   AtualizarIndicadores();
   DesenharBandasMA();
   
   Print("▶️ Grid Trader Compras v3.8 (Grid Contínuo Perpétuo) Iniciado!");
   return(INIT_SUCCEEDED);
}

void AdicionarIndicadoresNoGrafico()
{
   bool has_ma = false;
   int inds_main = ChartIndicatorsTotal(0, 0);
   for(int j = 0; j < inds_main; j++) {
      if(StringFind(ChartIndicatorName(0, 0, j), "MA") >= 0) { has_ma = true; break; }
   }
   if(!has_ma) ChartIndicatorAdd(0, 0, ma_handle);

   int sub_windows = (int)ChartGetInteger(0, CHART_WINDOWS_TOTAL);
   bool has_rsi14 = false;
   for(int i = 1; i < sub_windows; i++) {
      int inds = ChartIndicatorsTotal(0, i);
      for(int j = 0; j < inds; j++) {
         if(StringFind(ChartIndicatorName(0, i, j), "RSI") >= 0) { has_rsi14 = true; break; }
      }
   }
   if(!has_rsi14) ChartIndicatorAdd(0, sub_windows, rsi_lento_handle);
   
   sub_windows = (int)ChartGetInteger(0, CHART_WINDOWS_TOTAL);
   int target_window = sub_windows - 1;
   if(target_window < 1) target_window = 1;
   
   bool has_rsi9 = false;
   int inds_sub = ChartIndicatorsTotal(0, target_window);
   for(int j = 0; j < inds_sub; j++) {
      if(StringFind(ChartIndicatorName(0, target_window, j), "RSI") >= 0) { has_rsi9 = true; break; }
   }
   if(!has_rsi9) ChartIndicatorAdd(0, target_window, rsi_rapido_handle);
}

void OnDeinit(const int reason)
{
   if(rsi_rapido_handle != INVALID_HANDLE) IndicatorRelease(rsi_rapido_handle);
   if(rsi_lento_handle  != INVALID_HANDLE) IndicatorRelease(rsi_lento_handle);
   if(ma_handle         != INVALID_HANDLE) IndicatorRelease(ma_handle);
   DeletarTodosObjetos();
}

void OnTick()
{
   AtualizarIndicadores();
   DesenharBandasMA();
   AtualizarPainelModerno();

   if(VerificarStopSessao()) return;

   ExecutarEstrategiaCompra();
}

bool AtualizarIndicadores()
{
   if(rsi_rapido_handle == INVALID_HANDLE || rsi_lento_handle == INVALID_HANDLE || ma_handle == INVALID_HANDLE) 
      return false;
      
   double buffer_r9[1], buffer_r14[1], buffer_ma[1];
   
   if(CopyBuffer(rsi_rapido_handle, 0, 0, 1, buffer_r9) < 1) return false;
   if(CopyBuffer(rsi_lento_handle, 0, 0, 1, buffer_r14) < 1) return false;
   if(CopyBuffer(ma_handle, 0, 0, 1, buffer_ma) < 1) return false;
   
   rsi_rapido_atual = buffer_r9[0];
   rsi_lento_atual  = buffer_r14[0];
   ma_atual         = buffer_ma[0];
   
   return true;
}

void DesenharBandasMA()
{
   if(ma_handle == INVALID_HANDLE || !Usar_Filtro_MA200) return;
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   double banda_superior = ma_atual + (Distancia_Banda_MA * point);
   double banda_inferior = ma_atual - (Distancia_Banda_MA * point);
   
   CriarLinhaHorizontal("linha_banda_superior", banda_superior, Cor_Banda_Superior);
   CriarLinhaHorizontal("linha_banda_inferior", banda_inferior, Cor_Banda_Inferior);
}

void CriarLinhaHorizontal(string nome, double preco, color cor)
{
   if(ObjectFind(0, nome) < 0) {
      ObjectCreate(0, nome, OBJ_HLINE, 0, 0, preco);
      ObjectSetInteger(0, nome, OBJPROP_STYLE, STYLE_DOT);
      ObjectSetInteger(0, nome, OBJPROP_WIDTH, 1);
      ObjectSetInteger(0, nome, OBJPROP_BACK, true);
      ObjectSetInteger(0, nome, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, nome, OBJPROP_HIDDEN, true);
   } else {
      ObjectSetDouble(0, nome, OBJPROP_PRICE, preco);
   }
   ObjectSetInteger(0, nome, OBJPROP_COLOR, cor);
}

bool RSIPermiteCompra()
{
   if(!Usar_Filtro_RSI) return true;
   return (rsi_lento_atual < RSI_Nivel_Sobrevenda);
}

bool MAPermiteCompra()
{
   if(!Usar_Filtro_MA200) return true;
   double preco_atual = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   return (preco_atual > ma_atual);
}

bool VerificarStopSessao()
{
   if(!Usar_Stop_Financeiro) return false;

   double equity_atual = AccountInfoDouble(ACCOUNT_EQUITY);
   double resultado_sessao = equity_atual - capital_inicial_sessao;

   // Meta de Lucro (Stop Gain)
   if(Meta_Lucro_Sessao > 0 && resultado_sessao >= Meta_Lucro_Sessao)
   {
      Print("🎯 META DE LUCRO DA SESSÃO ATINGIDA: $", DoubleToString(resultado_sessao, 2));
      contador_resets++;
      ResetarEstrategia();
      return true;
   }

   // Stop Loss da Sessão
   if(Stop_Loss_Sessao > 0 && resultado_sessao <= -MathAbs(Stop_Loss_Sessao))
   {
      Print("🛑 STOP LOSS DA SESSÃO ATINGIDO: $", DoubleToString(resultado_sessao, 2));
      contador_resets++;
      ResetarEstrategia();
      return true;
   }

   return false;
}

void OnChartEvent(const int id, const long &lparam, const double &dparam, const string &sparam)
{
   if(id == CHARTEVENT_OBJECT_CLICK && sparam == "btn_reset")
   {
      int resposta = MessageBox("Deseja RESETAR MANUALMENTE a estratégia?", "Confirmar", MB_YESNO | MB_ICONWARNING);
      if(resposta == IDYES) {
         contador_resets++;
         ResetarEstrategia();
      }
      ObjectSetInteger(0, "btn_reset", OBJPROP_STATE, false);
      ChartRedraw();
   }
}

