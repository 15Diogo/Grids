void AtualizarPainelModerno()
{
   int x = Painel_X;
   int y = Painel_Y;
   int largura = PAINEL_LARGURA;
   
   CriarTexto("txt_titulo", x+15, y+10, "GRID TRADER PRO", clrWhite, 12, "Arial Black");
   string timeframe = EnumToString((ENUM_TIMEFRAMES)Period());
   StringReplace(timeframe, "PERIOD_", "");
   CriarTexto("txt_simbolo", x+15, y+27, _Symbol + "   •   " + timeframe, C'220,235,255', 9, "Courier New");
   
   double saldo_atual = AccountInfoDouble(ACCOUNT_BALANCE);
   double capital_atual = AccountInfoDouble(ACCOUNT_EQUITY); 
   double resultado_sessao = capital_atual - capital_inicial_sessao;
   color cor_resultado = (resultado_sessao >= 0) ? Cor_Positivo : Cor_Negativo;
   string sinal = (resultado_sessao >= 0) ? "+" : "";
   
   CriarTexto("txt_saldo_ini_lbl", x+25, y+80, "Saldo Inicial", Cor_Texto_Sec, 8, "Arial");
   CriarTexto("txt_saldo_ini_val", x+largura-120, y+80, "$" + DoubleToString(balance_inicial, 2), Cor_Texto, 9, "Courier New");
   
   CriarTexto("txt_saldo_atu_lbl", x+25, y+97, "Saldo Atual (Líquido)", Cor_Texto_Sec, 8, "Arial");
   CriarTexto("txt_saldo_atu_val", x+largura-120, y+97, "$" + DoubleToString(saldo_atual, 2), Cor_Texto, 9, "Courier New");
   
   CriarTexto("txt_patrimonio_lbl", x+25, y+114, "► Patrimônio Atual", C'255,200,50', 9, "Arial");
   CriarTexto("txt_patrimonio_val", x+largura-135, y+112, "$" + DoubleToString(capital_atual, 2), clrWhite, 11, "Arial Black");
   
   CriarTexto("txt_resultado_lbl", x+25, y+138, "Resultado Sessão", Cor_Texto_Sec, 8, "Arial");
   CriarTexto("txt_resultado_val", x+largura-150, y+136, sinal + "$" + DoubleToString(MathAbs(resultado_sessao), 2), cor_resultado, 11, "Arial Black");
   
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   
   CriarTexto("txt_ask_lbl", x+25, y+200, "Ask: " + DoubleToString(ask, _Digits), Cor_Texto, 9, "Courier New");
   CriarTexto("txt_bid_lbl", x+175, y+200, "Bid: " + DoubleToString(bid, _Digits), Cor_Texto, 9, "Courier New");
   
   color cor_r9 = (rsi_rapido_atual <= RSI_Nivel_Sobrevenda) ? Cor_Positivo : ((rsi_rapido_atual >= RSI_Nivel_Sobrecompra) ? Cor_Negativo : Cor_Alerta);
   color cor_r14 = (rsi_lento_atual <= RSI_Nivel_Sobrevenda) ? Cor_Positivo : ((rsi_lento_atual >= RSI_Nivel_Sobrecompra) ? Cor_Negativo : Cor_Alerta);
   
   CriarTexto("txt_rsi9_lbl", x+25, y+219, "RSI(9):", Cor_Texto_Sec, 8, "Arial");
   CriarTexto("txt_rsi9_val", x+68, y+219, DoubleToString(rsi_rapido_atual, 1), cor_r9, 8, "Arial Black");
   
   CriarTexto("txt_rsi14_lbl", x+135, y+219, "RSI(14):", Cor_Texto_Sec, 8, "Arial");
   CriarTexto("txt_rsi14_val", x+182, y+219, DoubleToString(rsi_lento_atual, 1), cor_r14, 8, "Arial Black");

   bool acima_media = (ask > ma_atual);
   color cor_ma = acima_media ? Cor_Positivo : Cor_Negativo;
   string ma_texto = Usar_Filtro_MA200 ? (acima_media?"ALTA ▲":"BAIXA ▼") : "OFF";
   CriarTexto("txt_ma_lbl", x+245, y+219, "MA: " + ma_texto, cor_ma, 8, "Arial Black");

   // Pílula de Status
   string txt_pill = "";
   color cor_pill;

   if(!grid_ja_ativado) {
      bool permitido = RSIPermiteCompra() && MAPermiteCompra();
      if(permitido) {
         txt_pill = "✅ GATILHO INICIAL LIBERADO";
         cor_pill = Cor_Positivo;
      } else {
         txt_pill = "⛔ AGUARDANDO RSI(14) SOBREVENDA";
         cor_pill = Cor_Negativo;
      }
   } else {
      txt_pill = "🔄 GRID CONTÍNUO PERPÉTUO ATIVO";
      cor_pill = C'0,150,255';
   }
   
   CriarObjetoPainel("painel_status_bg", x+15, y+242, largura-30, 22, cor_pill);
   CriarTexto("txt_status_val", x+15, y+247, txt_pill, clrWhite, 9, "Arial Black", CORNER_LEFT_UPPER);
   ObjectSetInteger(0, "txt_status_val", OBJPROP_ANCHOR, ANCHOR_LEFT);
   ObjectSetInteger(0, "txt_status_val", OBJPROP_XDISTANCE, x + (largura/2) - (StringLen(txt_pill)*3));

   int compras_ativas = ContarOrdens(POSITION_TYPE_BUY);
   double lote_atual = CalcularLoteAtual();
   double lucro_posicoes = CalcularLucroEA();
   
   CriarTexto("txt_compras_lbl", x+25, y+345, "▲ Posições Compradas", Cor_Positivo, 9, "Courier New");
   CriarTexto("txt_compras_val", x+largura-60, y+343, IntegerToString(compras_ativas), Cor_Texto, 12, "Arial Black");

   CriarTexto("txt_lote_lbl", x+25, y+365, "Lote Base/Atual", Cor_Texto_Sec, 8, "Arial");
   CriarTexto("txt_lote_val", x+largura-95, y+363, DoubleToString(lote_atual, 2) + " lotes", Cor_Header, 11, "Arial Black");
   
   string txt_prog = Usar_Lote_Progressivo ? "Próx. incremento em " + IntegerToString(Ordens_Para_Incrementar - (compras_ativas % Ordens_Para_Incrementar)) : "Prog. Off";
   CriarTexto("txt_prog_val", x+25, y+380, txt_prog, Cor_Texto_Sec, 8, "Courier New");

   color cor_lucro = (lucro_posicoes >= 0) ? Cor_Positivo : Cor_Negativo;
   CriarTexto("txt_lucro_lbl", x+25, y+395, "Lucro/Prejuízo Aberto", Cor_Texto, 9, "Arial");
   CriarTexto("txt_lucro_val", x+largura-135, y+393, (lucro_posicoes>=0?"+":"") + "$" + DoubleToString(MathAbs(lucro_posicoes), 2), cor_lucro, 11, "Arial Black");

   ChartRedraw(0);
}

double CalcularLucroEA()
{
   double lucro = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0) continue;
      if(PositionGetString(POSITION_SYMBOL) == _Symbol && PositionGetInteger(POSITION_MAGIC) == Magic_Number)
         lucro += PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
   }
   return lucro;
}

int ContarOrdens(ENUM_POSITION_TYPE tipo)
{
   int count = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0) continue;
      if(PositionGetString(POSITION_SYMBOL) == _Symbol && PositionGetInteger(POSITION_MAGIC) == Magic_Number)
         if((ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE) == tipo) count++;
   }
   return count;
}

void CriarObjetoPainel(string nome, int x, int y, int largura, int altura, color cor, int corner = CORNER_LEFT_UPPER)
{
   if(ObjectFind(0, nome) >= 0) ObjectDelete(0, nome);
   ObjectCreate(0, nome, OBJ_RECTANGLE_LABEL, 0, 0, 0);
   ObjectSetInteger(0, nome, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, nome, OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, nome, OBJPROP_XSIZE, largura);
   ObjectSetInteger(0, nome, OBJPROP_YSIZE, altura);
   ObjectSetInteger(0, nome, OBJPROP_BGCOLOR, cor);
   ObjectSetInteger(0, nome, OBJPROP_BORDER_TYPE, BORDER_FLAT);
   ObjectSetInteger(0, nome, OBJPROP_CORNER, corner);
   ObjectSetInteger(0, nome, OBJPROP_COLOR, cor);
   ObjectSetInteger(0, nome, OBJPROP_BACK, false);
   ObjectSetInteger(0, nome, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, nome, OBJPROP_HIDDEN, true);
}

void CriarTexto(string nome, int x, int y, string texto, color cor, int tamanho, string fonte = "Arial", int corner = CORNER_LEFT_UPPER)
{
   if(ObjectFind(0, nome) >= 0) ObjectDelete(0, nome);
   ObjectCreate(0, nome, OBJ_LABEL, 0, 0, 0);
   ObjectSetInteger(0, nome, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, nome, OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, nome, OBJPROP_CORNER, corner);
   ObjectSetInteger(0, nome, OBJPROP_COLOR, cor);
   ObjectSetString(0, nome, OBJPROP_FONT, fonte);
   ObjectSetInteger(0, nome, OBJPROP_FONTSIZE, tamanho);
   ObjectSetString(0, nome, OBJPROP_TEXT, texto);
   ObjectSetInteger(0, nome, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, nome, OBJPROP_HIDDEN, true);
}

void CriarBotao(string nome, int x, int y, int largura, int altura, string texto, color cor_fundo, color cor_texto)
{
   if(ObjectFind(0, nome) >= 0) ObjectDelete(0, nome);
   ObjectCreate(0, nome, OBJ_BUTTON, 0, 0, 0);
   ObjectSetInteger(0, nome, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, nome, OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, nome, OBJPROP_XSIZE, largura);
   ObjectSetInteger(0, nome, OBJPROP_YSIZE, altura);
   ObjectSetInteger(0, nome, OBJPROP_CORNER, CORNER_LEFT_UPPER);
   ObjectSetInteger(0, nome, OBJPROP_BGCOLOR, cor_fundo);
   ObjectSetInteger(0, nome, OBJPROP_COLOR, cor_texto);
   ObjectSetString(0, nome, OBJPROP_TEXT, texto);
   ObjectSetString(0, nome, OBJPROP_FONT, "Arial Black");
   ObjectSetInteger(0, nome, OBJPROP_FONTSIZE, 9);
   ObjectSetInteger(0, nome, OBJPROP_STATE, false);
   ObjectSetInteger(0, nome, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, nome, OBJPROP_HIDDEN, true);
}

