void CriarPainelModerno()
{
   ChartSetInteger(0, CHART_FOREGROUND, false);   // painel por cima dos candles
   AtualizarPainelModerno();
   if(Mostrar_Botao_Reset)
      CriarBotao("btn_reset", Painel_X + 12, Painel_Y + 444, PAINEL_LARGURA - 24, 28, "RESETAR ESTRATÉGIA", Cor_Botao, clrWhite);
   ChartRedraw();
}

void AtualizarPainelModerno()
{
   int x = Painel_X, y = Painel_Y;
   int W = PAINEL_LARGURA;
   int pad = 12;
   int iw = W - 2 * pad;
   int xi = x + pad;

   double saldo_atual      = AccountInfoDouble(ACCOUNT_BALANCE);
   double capital_atual    = AccountInfoDouble(ACCOUNT_EQUITY);
   double resultado_sessao = capital_atual - capital_inicial_sessao;
   double historico_sessao = CalcularHistoricoSessao();
   double lucro_posicoes   = CalcularLucroEA();
   double ask              = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double pct_sessao       = (capital_inicial_sessao > 0) ? (resultado_sessao / capital_inicial_sessao * 100.0) : 0.0;

   color cor_resultado = resultado_sessao >= 0 ? Cor_Positivo : Cor_Negativo;
   color cor_historico = historico_sessao >= 0 ? Cor_Positivo : Cor_Negativo;
   color cor_lucro     = lucro_posicoes   >= 0 ? Cor_Positivo : Cor_Negativo;
   color cor_rsi       = rsi_atual <= RSI_Nivel_Sobrevenda ? Cor_Positivo : (rsi_atual >= RSI_Nivel_Sobrecompra ? Cor_Negativo : Cor_Alerta);
   color cor_tendencia = ask >= ma_atual ? Cor_Positivo : Cor_Negativo;
   color cor_borda     = C'48,55,70';
   color cor_trilho    = C'38,44,58';

   int compras_ativas = ContarOrdens(POSITION_TYPE_BUY);
   int vendas_ativas  = ContarOrdens(POSITION_TYPE_SELL);
   string tf = EnumToString((ENUM_TIMEFRAMES)Period());
   StringReplace(tf, "PERIOD_", "");

   // ---------------- Fundo + Cabeçalho ----------------
   CriarObjetoPainel("pnl_fundo", x, y, W, PAINEL_ALTURA, Cor_Fundo, cor_borda);
   CriarObjetoPainel("pnl_topo",  x, y, W, 3, Cor_Header);

   CriarTexto("pnl_titulo", xi, y + 10, "FX RSI GRID", Cor_Header, 13, "Arial Black");
   CriarTexto("pnl_simbolo", xi, y + 32, _Symbol + "  •  " + tf, Cor_Texto_Sec, 8, "Segoe UI");

   bool ativo = grid_ja_ativado;
   color cor_status = ativo ? Cor_Positivo : Cor_Alerta;
   CriarObjetoPainel("pnl_pill", x + W - pad - 112, y + 14, 112, 22, C'30,36,48', cor_status);
   CriarTexto("pnl_pill_t", x + W - pad - 56, y + 25, ativo ? "●  GRID ATIVO" : "●  AGUARDANDO", cor_status, 8, "Segoe UI Semibold", ANCHOR_CENTER);

   // ---------------- Card SESSÃO ----------------
   int ya = y + 58;
   CartaoPainel("ses", x, ya, W, 154, "SESSÃO", "desde " + TimeToString(hora_inicio_sessao, TIME_MINUTES), Cor_Texto_Sec);

   CriarTexto("pnl_res_v", xi, ya + 20, Dinheiro(resultado_sessao, true), cor_resultado, 20, "Segoe UI Semibold");
   CriarTexto("pnl_res_p", x + W - 10, ya + 30, (pct_sessao >= 0 ? "+" : "") + DoubleToString(pct_sessao, 2) + "%", cor_resultado, 11, "Segoe UI Semibold", ANCHOR_RIGHT_UPPER);

   // Barra de progresso: -Stop Loss ... 0 ... +Meta
   int bx = xi, by = ya + 58, bw = iw - 2;
   double lim_neg = (Stop_Loss_Sessao > 0) ? -MathAbs(Stop_Loss_Sessao) : 0.0;
   double lim_pos = (Meta_Lucro_Sessao > 0) ? Meta_Lucro_Sessao : 0.0;
   bool barra_ok = (Usar_Stop_Financeiro && lim_neg < 0.0 && lim_pos > 0.0);

   CriarObjetoPainel("pnl_bar_trilho", bx, by, bw, 6, cor_trilho);
   if(barra_ok)
   {
      double faixa = lim_pos - lim_neg;
      int zero_x = bx + (int)MathRound(bw * (-lim_neg) / faixa);
      double r = MathMax(lim_neg, MathMin(lim_pos, resultado_sessao));
      int pos_x = bx + (int)MathRound(bw * (r - lim_neg) / faixa);
      int fx = (resultado_sessao >= 0) ? zero_x : pos_x;
      int fw = MathAbs(pos_x - zero_x);
      CriarObjetoPainel("pnl_bar_fill", fx, by, fw, 6, fw > 0 ? cor_resultado : cor_trilho);
      CriarObjetoPainel("pnl_bar_zero", zero_x - 1, by - 3, 2, 12, Cor_Texto);
      CriarTexto("pnl_bar_neg", bx, by + 11, Dinheiro(lim_neg, true), Cor_Negativo, 7, "Segoe UI");
      CriarTexto("pnl_bar_pos", bx + bw, by + 11, Dinheiro(lim_pos, true), Cor_Positivo, 7, "Segoe UI", ANCHOR_RIGHT_UPPER);
   }
   else
   {
      CriarObjetoPainel("pnl_bar_fill", bx, by, 1, 6, cor_trilho);
      CriarObjetoPainel("pnl_bar_zero", bx, by, 1, 6, cor_trilho);
      CriarTexto("pnl_bar_neg", bx, by + 11, "proteção desligada", Cor_Texto_Sec, 7, "Segoe UI");
      CriarTexto("pnl_bar_pos", bx + bw, by + 11, "", Cor_Texto_Sec, 7, "Segoe UI", ANCHOR_RIGHT_UPPER);
   }

   CriarObjetoPainel("pnl_ses_div", xi, ya + 82, iw, 1, cor_trilho);
   LinhaPainel("ses1", xi, ya + 88,  iw - 2, "Saldo atual",      Dinheiro(saldo_atual, false), Cor_Texto);
   LinhaPainel("ses2", xi, ya + 104, iw - 2, "Início da sessão", Dinheiro(capital_inicial_sessao, false), Cor_Texto);
   LinhaPainel("ses3", xi, ya + 120, iw - 2, "Histórico",        Dinheiro(historico_sessao, true), cor_historico);
   LinhaPainel("ses4", xi, ya + 136, iw - 2, "Flutuante",        Dinheiro(lucro_posicoes, true), cor_lucro);

   // ---------------- Card MERCADO ----------------
   int yb = y + 218;
   string zona = rsi_atual <= RSI_Nivel_Sobrevenda ? "SOBREVENDA" : (rsi_atual >= RSI_Nivel_Sobrecompra ? "SOBRECOMPRA" : "NEUTRO");
   CartaoPainel("mer", x, yb, W, 90, "MERCADO", zona, cor_rsi);

   LinhaPainel("rsi", xi, yb + 22, iw - 2, "RSI(" + IntegerToString(RSI_Periodo) + ")", DoubleToString(rsi_atual, 1), cor_rsi);
   int rby = yb + 42;
   CriarObjetoPainel("pnl_rsi_trilho", bx, rby, bw, 5, cor_trilho);
   double rsi_c = MathMax(0.0, MathMin(100.0, rsi_atual));
   CriarObjetoPainel("pnl_rsi_fill", bx, rby, (int)MathMax(1, MathRound(bw * rsi_c / 100.0)), 5, cor_rsi);
   CriarObjetoPainel("pnl_rsi_m1", bx + (int)MathRound(bw * RSI_Nivel_Sobrevenda  / 100.0), rby - 2, 1, 9, Cor_Texto);
   CriarObjetoPainel("pnl_rsi_m2", bx + (int)MathRound(bw * RSI_Nivel_Sobrecompra / 100.0), rby - 2, 1, 9, Cor_Texto);

   LinhaPainel("ma",  xi, yb + 54, iw - 2, "Preço vs MA(" + IntegerToString(MA_Periodo) + ")", ask >= ma_atual ? "ACIMA" : "ABAIXO", cor_tendencia);
   LinhaPainel("ask", xi, yb + 70, iw - 2, "Preço (Ask)", DoubleToString(ask, _Digits), Cor_Texto);

   // ---------------- Card OPERAÇÕES ----------------
   int yc = y + 314;
   CartaoPainel("ops", x, yc, W, 60, "OPERAÇÕES", "", Cor_Texto_Sec);
   int colw = iw / 4;
   string rot[4] = {"COMPRAS", "VENDAS", "LOTE", "CICLO"};
   string val[4];
   val[0] = IntegerToString(compras_ativas);
   val[1] = IntegerToString(vendas_ativas);
   val[2] = DoubleToString(CalcularLoteAtual(), 2);
   val[3] = IntegerToString(compras_abertas_ciclo);
   color cval[4];
   cval[0] = Cor_Positivo; cval[1] = Cor_Negativo; cval[2] = Cor_Header; cval[3] = Cor_Texto;
   for(int i = 0; i < 4; i++)
   {
      CriarTexto("pnl_ops_l" + IntegerToString(i), xi + i * colw, yc + 24, rot[i], Cor_Texto_Sec, 7, "Segoe UI");
      CriarTexto("pnl_ops_v" + IntegerToString(i), xi + i * colw, yc + 35, val[i], cval[i], 13, "Segoe UI Semibold");
   }

   // ---------------- Card PROTEÇÃO ----------------
   int yd = y + 380;
   CartaoPainel("pro", x, yd, W, 58, "PROTEÇÃO", Usar_Stop_Financeiro ? "ATIVA" : "DESLIGADA", Usar_Stop_Financeiro ? Cor_Positivo : Cor_Negativo);
   LinhaPainel("pro1", xi, yd + 22, iw - 2, "Stop Gain (meta)", Meta_Lucro_Sessao > 0 ? Dinheiro(Meta_Lucro_Sessao, true) : "OFF", Cor_Positivo);
   LinhaPainel("pro2", xi, yd + 38, iw - 2, "Stop Loss",        Stop_Loss_Sessao > 0 ? Dinheiro(-MathAbs(Stop_Loss_Sessao), true) : "OFF", Cor_Negativo);

   if(painel_sujo) { ChartRedraw(0); painel_sujo = false; }
}

double CalcularLucroEA()
{
   double lucro = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0) continue;
      if(PositionGetString(POSITION_SYMBOL) == _Symbol && PositionGetInteger(POSITION_MAGIC) == Magic_Number)
         lucro += PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
   }
   return lucro;
}

double CalcularHistoricoSessao()
{
   double resultado = 0.0;
   datetime fim = TimeCurrent();
   if(!HistorySelect(hora_inicio_sessao, fim)) return 0.0;

   int total = HistoryDealsTotal();
   for(int i = 0; i < total; i++)
   {
      ulong ticket = HistoryDealGetTicket(i);
      if(ticket == 0) continue;
      if(HistoryDealGetString(ticket, DEAL_SYMBOL) != _Symbol) continue;
      if((long)HistoryDealGetInteger(ticket, DEAL_MAGIC) != Magic_Number) continue;

      resultado += HistoryDealGetDouble(ticket, DEAL_PROFIT);
      resultado += HistoryDealGetDouble(ticket, DEAL_SWAP);
      resultado += HistoryDealGetDouble(ticket, DEAL_COMMISSION);
      resultado += HistoryDealGetDouble(ticket, DEAL_FEE);
   }
   return resultado;
}

int ContarOrdens(ENUM_POSITION_TYPE tipo)
{
   int count = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0) continue;
      if(PositionGetString(POSITION_SYMBOL) == _Symbol && PositionGetInteger(POSITION_MAGIC) == Magic_Number)
         if((ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE) == tipo) count++;
   }
   return count;
}

void CriarObjetoPainel(string nome, int x, int y, int largura, int altura, color cor, color borda)
{
   if(largura < 1) largura = 1;
   if(altura  < 1) altura  = 1;
   if(borda == clrNONE) borda = cor;

   if(ObjectFind(0, nome) < 0)
   {
      ObjectCreate(0, nome, OBJ_RECTANGLE_LABEL, 0, 0, 0);
      ObjectSetInteger(0, nome, OBJPROP_CORNER, CORNER_LEFT_UPPER);
      ObjectSetInteger(0, nome, OBJPROP_BORDER_TYPE, BORDER_FLAT);
      ObjectSetInteger(0, nome, OBJPROP_BACK, false);          // desenha POR CIMA do gráfico
      ObjectSetInteger(0, nome, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, nome, OBJPROP_SELECTED, false);
      ObjectSetInteger(0, nome, OBJPROP_HIDDEN, true);
      painel_sujo = true;
   }
   if(ObjectGetInteger(0, nome, OBJPROP_XDISTANCE) != x)   { ObjectSetInteger(0, nome, OBJPROP_XDISTANCE, x);   painel_sujo = true; }
   if(ObjectGetInteger(0, nome, OBJPROP_YDISTANCE) != y)   { ObjectSetInteger(0, nome, OBJPROP_YDISTANCE, y);   painel_sujo = true; }
   if(ObjectGetInteger(0, nome, OBJPROP_XSIZE) != largura) { ObjectSetInteger(0, nome, OBJPROP_XSIZE, largura); painel_sujo = true; }
   if(ObjectGetInteger(0, nome, OBJPROP_YSIZE) != altura)  { ObjectSetInteger(0, nome, OBJPROP_YSIZE, altura);  painel_sujo = true; }
   if(ObjectGetInteger(0, nome, OBJPROP_BGCOLOR) != cor)   { ObjectSetInteger(0, nome, OBJPROP_BGCOLOR, cor);   painel_sujo = true; }
   if(ObjectGetInteger(0, nome, OBJPROP_COLOR) != borda)   { ObjectSetInteger(0, nome, OBJPROP_COLOR, borda);   painel_sujo = true; }
}

void CriarTexto(string nome, int x, int y, string texto, color cor, int tamanho, string fonte, int ancora)
{
   if(ObjectFind(0, nome) < 0)
   {
      ObjectCreate(0, nome, OBJ_LABEL, 0, 0, 0);
      ObjectSetInteger(0, nome, OBJPROP_CORNER, CORNER_LEFT_UPPER);
      ObjectSetInteger(0, nome, OBJPROP_ANCHOR, ancora);
      ObjectSetInteger(0, nome, OBJPROP_XDISTANCE, x);
      ObjectSetInteger(0, nome, OBJPROP_YDISTANCE, y);
      ObjectSetString(0, nome, OBJPROP_FONT, fonte);
      ObjectSetInteger(0, nome, OBJPROP_FONTSIZE, tamanho);
      ObjectSetInteger(0, nome, OBJPROP_BACK, false);          // desenha POR CIMA do gráfico
      ObjectSetInteger(0, nome, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, nome, OBJPROP_SELECTED, false);
      ObjectSetInteger(0, nome, OBJPROP_HIDDEN, true);
      painel_sujo = true;
   }
   if(ObjectGetString(0, nome, OBJPROP_TEXT) != texto)  { ObjectSetString(0, nome, OBJPROP_TEXT, texto);  painel_sujo = true; }
   if(ObjectGetInteger(0, nome, OBJPROP_COLOR) != cor)  { ObjectSetInteger(0, nome, OBJPROP_COLOR, cor);  painel_sujo = true; }
}

void CriarBotao(string nome, int x, int y, int largura, int altura, string texto, color cor_fundo, color cor_texto)
{
   if(ObjectFind(0, nome) >= 0) ObjectDelete(0, nome);
   ObjectCreate(0, nome, OBJ_BUTTON, 0, 0, 0);
   ObjectSetInteger(0, nome, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, nome, OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, nome, OBJPROP_XSIZE, largura);
   ObjectSetInteger(0, nome, OBJPROP_YSIZE, altura);
   ObjectSetInteger(0, nome, OBJPROP_CORNER, CORNER_LEFT_UPPER);
   ObjectSetInteger(0, nome, OBJPROP_BGCOLOR, cor_fundo);
   ObjectSetInteger(0, nome, OBJPROP_BORDER_COLOR, cor_fundo);
   ObjectSetInteger(0, nome, OBJPROP_COLOR, cor_texto);
   ObjectSetString(0, nome, OBJPROP_TEXT, texto);
   ObjectSetString(0, nome, OBJPROP_FONT, "Segoe UI Semibold");
   ObjectSetInteger(0, nome, OBJPROP_FONTSIZE, 9);
   ObjectSetInteger(0, nome, OBJPROP_STATE, false);
   ObjectSetInteger(0, nome, OBJPROP_BACK, false);
   ObjectSetInteger(0, nome, OBJPROP_ZORDER, 10);
   ObjectSetInteger(0, nome, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, nome, OBJPROP_HIDDEN, true);
}

