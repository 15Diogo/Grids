input color    Cor_Card = C'28,32,42';               // Fundo dos cartões
input color    Cor_Header = C'212,175,55';           // Destaque (dourado)
input color    Cor_Positivo = C'46,204,113';         // Lucro / ativo (verde)
input color    Cor_Negativo = C'231,76,60';          // Prejuízo (vermelho)
input color    Cor_Alerta = C'241,196,15';           // Alerta (amarelo)
input color    Cor_Texto = C'236,238,243';           // Texto principal
input color    Cor_Texto_Sec = C'138,146,163';       // Texto secundário
input color    Cor_Botao = C'215,58,73';             // Botão RESETAR
input color    Cor_Botao_Start = C'39,174,96';       // Botão COMEÇAR GRID

// Variáveis Globais
CTrade trade;
