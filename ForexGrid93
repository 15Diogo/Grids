int OnInit()
{
   trade.SetExpertMagicNumber(Magic_Number);
   trade.SetDeviationInPoints(10);
   trade.SetTypeFillingBySymbol(_Symbol);

   balance_inicial = AccountInfoDouble(ACCOUNT_BALANCE);
   capital_inicial_sessao = AccountInfoDouble(ACCOUNT_EQUITY);
   hora_inicio_sessao = TimeCurrent();

   rsi_handle = iRSI(_Symbol, RSI_Timeframe, RSI_Periodo, RSI_Preco);
   ma_handle  = iMA(_Symbol, MA_Timeframe, MA_Periodo, 0, MA_Metodo, MA_Preco);

   if(rsi_handle == INVALID_HANDLE || ma_handle == INVALID_HANDLE)
   {
      Print("❌ ERRO: Falha ao criar os indicadores.");
      return(INIT_FAILED);
   }

   chave_estado = "GT_ON_" + IntegerToString(Magic_Number) + "_" + _Symbol;
   CarregarEstado();
   if(Iniciar_Automatico)
   {
      grid_habilitado = true;
      SalvarEstado();
   }

   // Recupera o estado se já existirem compras abertas (ex.: reinício do terminal)
   int compras_existentes = ContarOrdens(POSITION_TYPE_BUY);
   if(compras_existentes > 0)
   {
      grid_ja_ativado = true;
      compras_abertas_ciclo = compras_existentes;
   }

   AdicionarIndicadoresNoGrafico();
   AtualizarIndicadores();
   DesenharBandasMA();
   DesenharNiveisGrid();
   AtualizarPainelModerno();

   EventSetMillisecondTimer(500);

   Print("▶️ Grid Trader Compras v3.95 iniciado! Símbolo: ", _Symbol,
         " | Grid: ", (grid_habilitado ? "ATIVO" : "PARADO (clique em COMEÇAR GRID)"),
         " | StopsLevel: ", (int)SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL),
         " | Spread: ", (int)SymbolInfoInteger(_Symbol, SYMBOL_SPREAD));
   return(INIT_SUCCEEDED);
}

void OnDeinit(const int reason)
{
   EventKillTimer();
   if(rsi_handle != INVALID_HANDLE) IndicatorRelease(rsi_handle);
   if(ma_handle  != INVALID_HANDLE) IndicatorRelease(ma_handle);
   DeletarTodosObjetos();
}

void OnTimer()
{
   AtualizarIndicadores();
   AtualizarPainelModerno();
}

void OnTick()
{
   AtualizarIndicadores();
   DesenharBandasMA();
   DesenharNiveisGrid();

   if(GetTickCount64() - ultimo_update_painel >= 250)
      AtualizarPainelModerno();

   bool tem_operacao = grid_ja_ativado ||
                       (ContarOrdens(POSITION_TYPE_BUY) + ContarOrdens(POSITION_TYPE_SELL) > 0);
   if(tem_operacao && VerificarStopSessao()) return;

   if(!grid_habilitado) return;

   ExecutarEstrategiaCompra();
}

//+------------------------------------------------------------------+
//| Estado persistente (sobrevive a reinício do terminal)            |
//+------------------------------------------------------------------+
void SalvarEstado()
{
   GlobalVariableSet(chave_estado, grid_habilitado ? 1.0 : 0.0);
}

void CarregarEstado()
{
   if(GlobalVariableCheck(chave_estado))
      grid_habilitado = (GlobalVariableGet(chave_estado) > 0.5);
   else
      grid_habilitado = false;
}

//+------------------------------------------------------------------+
//| Botão COMEÇAR / PAUSAR / RETOMAR                                 |
//+------------------------------------------------------------------+
void AlternarGrid()
{
   if(!grid_habilitado)
   {
      int compras = ContarOrdens(POSITION_TYPE_BUY);
      if(compras > 0)
      {
         // Retomando um grid que já tem posições abertas
         grid_ja_ativado = true;
         if(compras_abertas_ciclo < compras) compras_abertas_ciclo = compras;
      }
      else if(!grid_ja_ativado)
      {
         // Início limpo: zera a base da sessão
         capital_inicial_sessao = AccountInfoDouble(ACCOUNT_EQUITY);
         balance_inicial = AccountInfoDouble(ACCOUNT_BALANCE);
         hora_inicio_sessao = TimeCurrent();
         compras_abertas_ciclo = 0;
         ignorar_filtros_entrada = Botao_Ignora_Filtros;
      }
      grid_habilitado = true;
      Print("▶️ GRID INICIADO pelo botão.");
   }
   else
   {
      grid_habilitado = false;
      ignorar_filtros_entrada = false;
      Print("⏸ GRID PAUSADO (posições abertas continuam com seus TPs).");
   }
   SalvarEstado();
   AtualizarPainelModerno();
}

void AdicionarIndicadoresNoGrafico()
{
   bool has_ma = false;
   int inds_main = ChartIndicatorsTotal(0, 0);
   for(int j = 0; j < inds_main; j++) {
      if(StringFind(ChartIndicatorName(0, 0, j), "MA") >= 0) { has_ma = true; break; }
   }
   if(!has_ma) ChartIndicatorAdd(0, 0, ma_handle);

   int sub_windows = (int)ChartGetInteger(0, CHART_WINDOWS_TOTAL);
   bool has_rsi = false;
   for(int i = 1; i < sub_windows; i++) {
      int inds = ChartIndicatorsTotal(0, i);
      for(int j = 0; j < inds; j++) {
         if(StringFind(ChartIndicatorName(0, i, j), "RSI") >= 0) { has_rsi = true; break; }
      }
   }
   if(!has_rsi) ChartIndicatorAdd(0, sub_windows, rsi_handle);
}

bool AtualizarIndicadores()
{
   indicadores_ok = false;
   if(rsi_handle == INVALID_HANDLE || ma_handle == INVALID_HANDLE) return false;
   double buffer_rsi[1], buffer_ma[1];

   if(CopyBuffer(rsi_handle, 0, 0, 1, buffer_rsi) < 1)
   {
      if(Mostrar_Logs_Debug && TimeCurrent() - ultimo_log_debug > 10)
      {
         ultimo_log_debug = TimeCurrent();
         Print("⚠️ Não foi possível ler o RSI (erro ", GetLastError(), "). Aguardando dados...");
      }
      return false;
   }
   if(CopyBuffer(ma_handle, 0, 0, 1, buffer_ma) < 1)
   {
      if(Mostrar_Logs_Debug && TimeCurrent() - ultimo_log_debug > 10)
      {
         ultimo_log_debug = TimeCurrent();
         Print("⚠️ Não foi possível ler a MA (erro ", GetLastError(), "). Aguardando dados...");
      }
      return false;
   }
   rsi_atual = buffer_rsi[0];
   ma_atual  = buffer_ma[0];
   indicadores_ok = true;
   return true;
}

void DesenharBandasMA()
{
   if(ma_handle == INVALID_HANDLE) return;
   CriarLinhaHorizontal("linha_ma200", ma_atual, Cor_Negativo);
   if(!Usar_Filtro_MA200) {
      ObjectDelete(0, "linha_banda_superior");
      ObjectDelete(0, "linha_banda_inferior");
      return;
   }
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   CriarLinhaHorizontal("linha_banda_superior", ma_atual + (Distancia_Banda_MA * point), Cor_Header);
   CriarLinhaHorizontal("linha_banda_inferior", ma_atual - (Distancia_Banda_MA * point), Cor_Header);
}

void DesenharNiveisGrid()
{
   for(int n = 0; n < 100; n++) ObjectDelete(0, "linha_grid_" + IntegerToString(n));
   int nivel = 0;
   for(int i = PositionsTotal() - 1; i >= 0 && nivel < 100; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol || PositionGetInteger(POSITION_MAGIC) != Magic_Number) continue;
      if((ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE) != POSITION_TYPE_BUY) continue;
      string nome = "linha_grid_" + IntegerToString(nivel);
      CriarLinhaHorizontal(nome, PositionGetDouble(POSITION_PRICE_OPEN), Cor_Header);
      ObjectSetInteger(0, nome, OBJPROP_STYLE, STYLE_DOT);
      ObjectSetInteger(0, nome, OBJPROP_WIDTH, 1);
      nivel++;
   }
}

void CriarLinhaHorizontal(string nome, double preco, color cor)
{
   if(ObjectFind(0, nome) < 0) {
      ObjectCreate(0, nome, OBJ_HLINE, 0, 0, preco);
      ObjectSetInteger(0, nome, OBJPROP_STYLE, STYLE_DOT);
      ObjectSetInteger(0, nome, OBJPROP_WIDTH, 1);
      ObjectSetInteger(0, nome, OBJPROP_BACK, true);
      ObjectSetInteger(0, nome, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, nome, OBJPROP_HIDDEN, true);
   } else {
      ObjectSetDouble(0, nome, OBJPROP_PRICE, preco);
   }
   ObjectSetInteger(0, nome, OBJPROP_COLOR, cor);
}

bool RSIPermiteCompra()
{
   if(!Usar_Filtro_RSI) return true;
   if(!indicadores_ok) return false;   // não opera com RSI desatualizado
   return (rsi_atual < RSI_Nivel_Sobrevenda);
}

bool MAPermiteCompra()
{
   if(!Usar_Filtro_MA200) return true;
   if(!indicadores_ok) return false;
   double preco_atual = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   return (preco_atual > ma_atual);
}

bool VerificarStopSessao()
{
   if(!Usar_Stop_Financeiro) return false;
   double equity_atual = AccountInfoDouble(ACCOUNT_EQUITY);
   double resultado_sessao = equity_atual - capital_inicial_sessao;

   if(Meta_Lucro_Sessao > 0 && resultado_sessao >= Meta_Lucro_Sessao)
   {
      Print("🎯 META DE LUCRO ATINGIDA: $", DoubleToString(resultado_sessao, 2));
      contador_resets++;
      ResetarEstrategia(Rearmar_Apos_Stop);
      return true;
   }

   if(Stop_Loss_Sessao > 0 && resultado_sessao <= -MathAbs(Stop_Loss_Sessao))
   {
      Print("🛑 STOP LOSS DE $", DoubleToString(Stop_Loss_Sessao, 0), " ATINGIDO: $", DoubleToString(resultado_sessao, 2));
      contador_resets++;
      ResetarEstrategia(Rearmar_Apos_Stop);
      return true;
   }
   return false;
}

void OnChartEvent(const int id, const long &lparam, const double &dparam, const string &sparam)
{
   if(id != CHARTEVENT_OBJECT_CLICK) return;

   if(sparam == "gt_btn_start")
   {
      AlternarGrid();
      ObjectSetInteger(0, "gt_btn_start", OBJPROP_STATE, false);
      ChartRedraw();
   }
   else if(sparam == "gt_btn_reset")
   {
      int resposta = MessageBox("Deseja RESETAR MANUALMENTE a estratégia?\nTodas as posições do EA serão fechadas.", "Confirmar", MB_YESNO | MB_ICONWARNING);
      if(resposta == IDYES) {
         contador_resets++;
         ResetarEstrategia(false);
      }
      ObjectSetInteger(0, "gt_btn_reset", OBJPROP_STATE, false);
      ChartRedraw();
   }
}

void ExecutarEstrategiaCompra()
{
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   int ordens_compradas = ContarOrdens(POSITION_TYPE_BUY);

   if(!grid_ja_ativado)
   {
      if(ordens_compradas == 0)
      {
         if(!ignorar_filtros_entrada && (!RSIPermiteCompra() || !MAPermiteCompra()))
         {
            if(Mostrar_Logs_Debug && TimeCurrent() - ultimo_log_debug > 30)
            {
               ultimo_log_debug = TimeCurrent();
               Print("⏳ Aguardando gatilho: RSI=", DoubleToString(rsi_atual, 1),
                     " (precisa < ", DoubleToString(RSI_Nivel_Sobrevenda, 1), ")",
                     " | RSI ok=", RSIPermiteCompra(),
                     " | MA ok=", MAPermiteCompra(),
                     " | Indicadores lidos=", indicadores_ok);
            }
            return;
         }
         // Nova base da sessão no instante em que o grid começa
         capital_inicial_sessao = AccountInfoDouble(ACCOUNT_EQUITY);
         balance_inicial = AccountInfoDouble(ACCOUNT_BALANCE);
         hora_inicio_sessao = TimeCurrent();
         if(AbrirOrdemCompra(ask))
         {
            grid_ja_ativado = true;
            ignorar_filtros_entrada = false;
         }
      }
      return;
   }

   if(ordens_compradas == 0)
   {
      AbrirOrdemCompra(ask);
      return;
   }

   if(ExisteCompraProxima(ask, Distancia_Grid_Compra)) return;

   double menor_distancia = 999999;
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol || PositionGetInteger(POSITION_MAGIC) != Magic_Number) continue;
      if((ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE) != POSITION_TYPE_BUY) continue;

      double preco_ordem = PositionGetDouble(POSITION_PRICE_OPEN);
      double distancia = MathAbs((ask - preco_ordem) / point);
      if(distancia < menor_distancia) menor_distancia = distancia;
   }

   if(menor_distancia >= Distancia_Grid_Compra) AbrirOrdemCompra(ask);
}

bool ExisteCompraProxima(double preco, int distancia_minima)
{
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol || PositionGetInteger(POSITION_MAGIC) != Magic_Number) continue;
      if((ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE) != POSITION_TYPE_BUY) continue;

      double preco_ordem = PositionGetDouble(POSITION_PRICE_OPEN);
      double distancia = MathAbs((preco - preco_ordem) / point);
      if(distancia < distancia_minima * 0.5) return true;
   }
   return false;
}

double NormalizarLote(double lote)
{
   double lote_min  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double lote_max  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double lote_step = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   if(lote_step > 0) lote = MathRound(lote / lote_step) * lote_step;
   lote = NormalizeDouble(lote, 2);
   if(lote < lote_min) lote = lote_min;
   if(lote > lote_max) lote = lote_max;
   return lote;
}

double CalcularLoteAtual()
{
   double lote = Lote_Compra;
   if(Usar_Lote_Progressivo && Ordens_Para_Incrementar > 0)
   {
      int compras_ativas = ContarOrdens(POSITION_TYPE_BUY);
      int nivel = compras_ativas / Ordens_Para_Incrementar;
      lote = Lote_Compra + (nivel * Incremento_Lote_Compra);
   }
   return NormalizarLote(lote);
}

// Garante que o TP respeite a distância mínima exigida pela corretora (stops level + spread)
int DistanciaMinimaStop(int pontos_desejados)
{
   int stops_level = (int)SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL);
   int freeze      = (int)SymbolInfoInteger(_Symbol, SYMBOL_TRADE_FREEZE_LEVEL);
   int spread      = (int)SymbolInfoInteger(_Symbol, SYMBOL_SPREAD);
   int minimo      = MathMax(stops_level, freeze) + spread + 5;
   return MathMax(pontos_desejados, minimo);
}

bool AbrirOrdemCompra(double preco)
{
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   int digits = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   int tp_pontos = DistanciaMinimaStop(Take_Profit_Compra);

   double tp = NormalizeDouble(preco + (tp_pontos * point), digits);
   double lote_atual = CalcularLoteAtual();

   bool ok = trade.Buy(lote_atual, _Symbol, 0, 0, tp, "Grid Buy L" + DoubleToString(lote_atual, 2));
   if(!ok)
   {
      // Alguns servidores recusam TP na abertura: tenta sem TP e aplica depois
      Print("⚠️ Falha ao abrir compra: ", trade.ResultRetcode(), " - ", trade.ResultRetcodeDescription(),
            " | tentando novamente sem TP...");
      ok = trade.Buy(lote_atual, _Symbol, 0, 0, 0, "Grid Buy L" + DoubleToString(lote_atual, 2));
      if(!ok)
      {
         Print("❌ Compra recusada: ", trade.ResultRetcode(), " - ", trade.ResultRetcodeDescription());
         return false;
      }
      ulong ticket = trade.ResultOrder();
      if(PositionSelectByTicket(ticket))
      {
         double abertura = PositionGetDouble(POSITION_PRICE_OPEN);
         double tp_pos = NormalizeDouble(abertura + (tp_pontos * point), digits);
         if(!trade.PositionModify(ticket, 0, tp_pos))
            Print("⚠️ Não foi possível definir o TP: ", trade.ResultRetcode(), " - ", trade.ResultRetcodeDescription());
      }
   }

   // A cada N compras abertas no ciclo (7, 14, 21...) abre 1 venda
   compras_abertas_ciclo++;
   if(Usar_Venda_Periodica && Compras_Para_Venda > 0 && (compras_abertas_ciclo % Compras_Para_Venda) == 0)
      AbrirOrdemVenda();

   return true;
}

bool AbrirOrdemVenda()
{
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   int digits = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   int tp_pontos = DistanciaMinimaStop(Take_Profit_Venda);

   double tp = NormalizeDouble(bid - (tp_pontos * point), digits);
   double lote = NormalizarLote(Lote_Venda);

   bool ok = trade.Sell(lote, _Symbol, 0, 0, tp, "Grid Sell #" + IntegerToString(compras_abertas_ciclo / Compras_Para_Venda));
   if(!ok)
      Print("⚠️ Falha ao abrir venda: ", trade.ResultRetcode(), " - ", trade.ResultRetcodeDescription());
   return ok;
}

void FecharTodasPosicoes()
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0) continue;
      if(PositionGetString(POSITION_SYMBOL) == _Symbol && PositionGetInteger(POSITION_MAGIC) == Magic_Number)
         trade.PositionClose(ticket);
   }
}

// manter_ativo = true  -> continua habilitado e volta a esperar o gatilho RSI
// manter_ativo = false -> volta ao estado PARADO (aguarda clique em COMEÇAR GRID)
void ResetarEstrategia(bool manter_ativo)
{
   FecharTodasPosicoes();
   grid_ja_ativado = false;
   ignorar_filtros_entrada = false;
   compras_abertas_ciclo = 0;
   if(!manter_ativo) grid_habilitado = false;
   SalvarEstado();
   balance_inicial = AccountInfoDouble(ACCOUNT_BALANCE);
   capital_inicial_sessao = AccountInfoDouble(ACCOUNT_EQUITY);
   hora_inicio_sessao = TimeCurrent();
   ultimo_update_hist = 0;
   AtualizarPainelModerno();
}

double CalcularLucroEA()
{
   double lucro = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0) continue;
      if(PositionGetString(POSITION_SYMBOL) == _Symbol && PositionGetInteger(POSITION_MAGIC) == Magic_Number)
         lucro += PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
   }
   return lucro;
}

double CalcularHistoricoSessao()
{
   double resultado = 0.0;
   datetime fim = TimeCurrent();
   if(!HistorySelect(hora_inicio_sessao, fim)) return 0.0;

   int total = HistoryDealsTotal();
   for(int i = 0; i < total; i++)
   {
      ulong ticket = HistoryDealGetTicket(i);
      if(ticket == 0) continue;
      if(HistoryDealGetString(ticket, DEAL_SYMBOL) != _Symbol) continue;
      if((long)HistoryDealGetInteger(ticket, DEAL_MAGIC) != Magic_Number) continue;

      resultado += HistoryDealGetDouble(ticket, DEAL_PROFIT);
      resultado += HistoryDealGetDouble(ticket, DEAL_SWAP);
      resultado += HistoryDealGetDouble(ticket, DEAL_COMMISSION);
      resultado += HistoryDealGetDouble(ticket, DEAL_FEE);
   }
   return resultado;
}

int ContarOrdens(ENUM_POSITION_TYPE tipo)
{
   int count = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0) continue;
      if(PositionGetString(POSITION_SYMBOL) == _Symbol && PositionGetInteger(POSITION_MAGIC) == Magic_Number)
         if((ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE) == tipo) count++;
   }
   return count;
}

