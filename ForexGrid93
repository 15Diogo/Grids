void PRect(string nome, int x, int y, int w, int h, color fundo, color borda)
{
   nome = "gt_" + nome;
   if(ObjectFind(0, nome) < 0)
   {
      ObjectCreate(0, nome, OBJ_RECTANGLE_LABEL, 0, 0, 0);
      ObjectSetInteger(0, nome, OBJPROP_CORNER, CORNER_LEFT_UPPER);
      ObjectSetInteger(0, nome, OBJPROP_BORDER_TYPE, BORDER_FLAT);
      ObjectSetInteger(0, nome, OBJPROP_BACK, false);
      ObjectSetInteger(0, nome, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, nome, OBJPROP_HIDDEN, true);
   }
   ObjectSetInteger(0, nome, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, nome, OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, nome, OBJPROP_XSIZE, MathMax(1, w));
   ObjectSetInteger(0, nome, OBJPROP_YSIZE, MathMax(1, h));
   ObjectSetInteger(0, nome, OBJPROP_BGCOLOR, fundo);
   ObjectSetInteger(0, nome, OBJPROP_COLOR, borda);
}

void PTxt(string nome, int x, int y, string texto, color cor, int tamanho = 8,
          string fonte = "Arial", ENUM_ANCHOR_POINT ancora = ANCHOR_LEFT_UPPER)
{
   nome = "gt_" + nome;
   if(ObjectFind(0, nome) < 0)
   {
      ObjectCreate(0, nome, OBJ_LABEL, 0, 0, 0);
      ObjectSetInteger(0, nome, OBJPROP_CORNER, CORNER_LEFT_UPPER);
      ObjectSetInteger(0, nome, OBJPROP_BACK, false);
      ObjectSetInteger(0, nome, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, nome, OBJPROP_HIDDEN, true);
   }
   ObjectSetInteger(0, nome, OBJPROP_ANCHOR, ancora);
   ObjectSetInteger(0, nome, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, nome, OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, nome, OBJPROP_COLOR, cor);
   ObjectSetString(0, nome, OBJPROP_FONT, fonte);
   ObjectSetInteger(0, nome, OBJPROP_FONTSIZE, tamanho);
   ObjectSetString(0, nome, OBJPROP_TEXT, texto);
}

void PBtn(string nome, int x, int y, int w, int h, string texto, color fundo, color cor_texto)
{
   nome = "gt_" + nome;
   if(ObjectFind(0, nome) < 0)
   {
      ObjectCreate(0, nome, OBJ_BUTTON, 0, 0, 0);
      ObjectSetInteger(0, nome, OBJPROP_CORNER, CORNER_LEFT_UPPER);
      ObjectSetInteger(0, nome, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, nome, OBJPROP_HIDDEN, true);
      ObjectSetString(0, nome, OBJPROP_FONT, "Arial Black");
      ObjectSetInteger(0, nome, OBJPROP_FONTSIZE, 9);
   }
   ObjectSetInteger(0, nome, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, nome, OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, nome, OBJPROP_XSIZE, w);
   ObjectSetInteger(0, nome, OBJPROP_YSIZE, h);
   ObjectSetInteger(0, nome, OBJPROP_BGCOLOR, fundo);
   ObjectSetInteger(0, nome, OBJPROP_BORDER_COLOR, fundo);
   ObjectSetInteger(0, nome, OBJPROP_COLOR, cor_texto);
   ObjectSetString(0, nome, OBJPROP_TEXT, texto);
}

// Cartão pequeno: rótulo em cima, valor embaixo
void PTile(string id, int x, int y, int w, int h, string rotulo, string valor, color cor_valor)
{
   PRect(id + "_bg", x, y, w, h, Cor_Card, COR_BORDA);
   PTxt(id + "_l", x + 9, y + 6, rotulo, Cor_Texto_Sec, 7, "Arial");
   PTxt(id + "_v", x + 9, y + 19, valor, cor_valor, 10, "Arial Black");
}

string PDinheiro(double v)
{
   return (v >= 0 ? "+$" : "-$") + DoubleToString(MathAbs(v), 2);
}

//+------------------------------------------------------------------+
//| PAINEL — desenho completo                                        |
//+------------------------------------------------------------------+
void AtualizarPainelModerno()
{
   ultimo_update_painel = GetTickCount64();

   int x = Painel_X, y = Painel_Y;
   int W = PAINEL_LARGURA, H = PAINEL_ALTURA;
   int p = 10;                       // margem
   int tw = (W - 3 * p) / 2;         // largura dos cartões pequenos
   int th = 42;                      // altura dos cartões pequenos
   int cx2 = x + p + tw + p;         // x da 2ª coluna
   int fw = W - 2 * p;               // largura total interna

   // ----- Dados -----
   double saldo = AccountInfoDouble(ACCOUNT_BALANCE);
   double equity = AccountInfoDouble(ACCOUNT_EQUITY);
   double resultado = equity - capital_inicial_sessao;
   double flutuante = CalcularLucroEA();
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   int compras = ContarOrdens(POSITION_TYPE_BUY);
   int vendas  = ContarOrdens(POSITION_TYPE_SELL);
   bool tem_pos = (compras + vendas) > 0;

   if(GetTickCount64() - ultimo_update_hist >= 2000)
   {
      historico_cache = CalcularHistoricoSessao();
      ultimo_update_hist = GetTickCount64();
   }

   string tf = EnumToString((ENUM_TIMEFRAMES)Period());
   StringReplace(tf, "PERIOD_", "");

   // ----- Status -----
   string txt_status;
   color  cor_status;
   if(!grid_habilitado)
   {
      if(grid_ja_ativado || tem_pos) { txt_status = "● PAUSADO"; cor_status = Cor_Alerta; }
      else                           { txt_status = "● PARADO";  cor_status = Cor_Texto_Sec; }
   }
   else if(!grid_ja_ativado) { txt_status = "● AGUARDANDO RSI"; cor_status = Cor_Alerta; }
   else                      { txt_status = "● GRID ATIVO";     cor_status = Cor_Positivo; }

   // ----- Fundo e cabeçalho -----
   PRect("bg", x, y, W, H, Cor_Fundo, COR_BORDA);
   PRect("top", x, y, W, 3, Cor_Header, Cor_Header);
   PTxt("title", x + p, y + 12, "GRID TRADER", Cor_Header, 11, "Arial Black");
   PTxt("sub", x + p, y + 31, _Symbol + "  •  " + tf, Cor_Texto_Sec, 8, "Arial");

   int pw = 138;
   PRect("pill", x + W - p - pw, y + 13, pw, 24, Cor_Card, cor_status);
   PTxt("pill_t", x + W - p - pw / 2, y + 25, txt_status, cor_status, 8, "Arial Black", ANCHOR_CENTER);

   // ----- Cartões da conta -----
   int r1 = y + 56, r2 = r1 + th + 6, r3 = r2 + th + 6, r4 = r3 + th + 6;
   PTile("t_saldo",  x + p, r1, tw, th, "SALDO", "$" + DoubleToString(saldo, 2), Cor_Texto);
   PTile("t_equity", cx2,   r1, tw, th, "EQUITY", "$" + DoubleToString(equity, 2), Cor_Texto);

   PTile("t_res",  x + p, r2, tw, th, "RESULTADO DA SESSÃO", PDinheiro(resultado), resultado >= 0 ? Cor_Positivo : Cor_Negativo);
   PTile("t_flut", cx2,   r2, tw, th, "FLUTUANTE", PDinheiro(flutuante), flutuante >= 0 ? Cor_Positivo : Cor_Negativo);

   PTile("t_comp", x + p, r3, tw, th, "COMPRAS ABERTAS", IntegerToString(compras) + "  ×  " + DoubleToString(CalcularLoteAtual(), 2), Cor_Texto);
   PTile("t_vend", cx2,   r3, tw, th, "VENDAS  |  CICLO", IntegerToString(vendas) + "  |  " + IntegerToString(compras_abertas_ciclo), Cor_Texto);

   PTile("t_hist", x + p, r4, tw, th, "HISTÓRICO DA SESSÃO", PDinheiro(historico_cache), historico_cache >= 0 ? Cor_Positivo : Cor_Negativo);
   PTile("t_ini",  cx2,   r4, tw, th, "INÍCIO DA SESSÃO", "$" + DoubleToString(capital_inicial_sessao, 2), Cor_Texto);

   // ----- Bloco RSI -----
   int ry = r4 + th + 8;
   int bw = fw - 18;                 // largura da barra
   int bx = x + p + 9;
   color cor_rsi = rsi_atual <= RSI_Nivel_Sobrevenda ? Cor_Positivo : (rsi_atual >= RSI_Nivel_Sobrecompra ? Cor_Negativo : Cor_Alerta);
   string zona = rsi_atual < RSI_Nivel_Sobrevenda ? "SOBREVENDA" : (rsi_atual > RSI_Nivel_Sobrecompra ? "SOBRECOMPRA" : "NEUTRO");
   color cor_ma = ask >= ma_atual ? Cor_Positivo : Cor_Negativo;

   PRect("rsi_bg", x + p, ry, fw, 62, Cor_Card, COR_BORDA);
   PTxt("rsi_l", bx, ry + 7, "RSI (" + IntegerToString(RSI_Periodo) + ")", Cor_Texto_Sec, 7, "Arial");
   PTxt("rsi_v", bx + bw, ry + 4, DoubleToString(rsi_atual, 1), cor_rsi, 11, "Arial Black", ANCHOR_RIGHT_UPPER);
   PRect("rsi_trilho", bx, ry + 28, bw, 6, C'45,50,64', C'45,50,64');
   double rsi_pct = MathMax(0.0, MathMin(100.0, rsi_atual));
   PRect("rsi_fill", bx, ry + 28, (int)(bw * rsi_pct / 100.0), 6, cor_rsi, cor_rsi);
   PRect("rsi_m30", bx + (int)(bw * RSI_Nivel_Sobrevenda / 100.0), ry + 25, 2, 12, Cor_Texto, Cor_Texto);
   PRect("rsi_m70", bx + (int)(bw * RSI_Nivel_Sobrecompra / 100.0), ry + 25, 2, 12, Cor_Texto, Cor_Texto);
   PTxt("rsi_zona", bx, ry + 42, zona, cor_rsi, 7, "Arial Black");
   PTxt("ma_t", bx + bw, ry + 42, ask >= ma_atual ? "PREÇO ACIMA DA MA" : "PREÇO ABAIXO DA MA", cor_ma, 7, "Arial Black", ANCHOR_RIGHT_UPPER);

   // ----- Bloco de proteção -----
   int py = ry + 62 + 8;
   double meta = MathAbs(Meta_Lucro_Sessao);
   double loss = MathAbs(Stop_Loss_Sessao);
   double ganho_atual = MathMax(0.0, resultado);
   double perda_atual = MathMax(0.0, -resultado);
   int fill_gain = (Usar_Stop_Financeiro && meta > 0) ? (int)(bw * MathMin(1.0, ganho_atual / meta)) : 0;
   int fill_loss = (Usar_Stop_Financeiro && loss > 0) ? (int)(bw * MathMin(1.0, perda_atual / loss)) : 0;

   PRect("prot_bg", x + p, py, fw, 70, Cor_Card, COR_BORDA);
   PTxt("prot_t", bx, py + 7, Usar_Stop_Financeiro ? "PROTEÇÃO ATIVA" : "PROTEÇÃO OFF", Usar_Stop_Financeiro ? Cor_Positivo : Cor_Negativo, 7, "Arial Black");
   PTxt("prot_lim", bx + bw, py + 7, "GAIN +$" + DoubleToString(meta, 0) + "  |  LOSS -$" + DoubleToString(loss, 0), Cor_Texto_Sec, 7, "Arial", ANCHOR_RIGHT_UPPER);

   PTxt("gain_l", bx, py + 23, "GAIN", Cor_Texto_Sec, 7, "Arial");
   PTxt("gain_v", bx + bw, py + 23, "$" + DoubleToString(ganho_atual, 2) + " / $" + DoubleToString(meta, 0), Cor_Texto, 7, "Arial", ANCHOR_RIGHT_UPPER);
   PRect("gain_trilho", bx, py + 35, bw, 5, C'45,50,64', C'45,50,64');
   PRect("gain_fill", bx, py + 35, fill_gain, 5, Cor_Positivo, Cor_Positivo);
   if(fill_gain <= 0) ObjectSetInteger(0, "gt_gain_fill", OBJPROP_XSIZE, 1);

   PTxt("loss_l", bx, py + 45, "LOSS", Cor_Texto_Sec, 7, "Arial");
   PTxt("loss_v", bx + bw, py + 45, "$" + DoubleToString(perda_atual, 2) + " / $" + DoubleToString(loss, 0), Cor_Texto, 7, "Arial", ANCHOR_RIGHT_UPPER);
   PRect("loss_trilho", bx, py + 57, bw, 5, C'45,50,64', C'45,50,64');
   PRect("loss_fill", bx, py + 57, fill_loss, 5, Cor_Negativo, Cor_Negativo);
   if(fill_loss <= 0) ObjectSetInteger(0, "gt_loss_fill", OBJPROP_XSIZE, 1);

   // ----- Botões -----
   int by = py + 70 + 10;
   string txt_btn;
   color  cor_btn, cor_txt_btn;
   if(!grid_habilitado)
   {
      txt_btn = (grid_ja_ativado || tem_pos) ? "RETOMAR GRID" : "COMEÇAR GRID";
      cor_btn = Cor_Botao_Start;
      cor_txt_btn = clrWhite;
   }
   else
   {
      txt_btn = "PAUSAR GRID";
      cor_btn = Cor_Alerta;
      cor_txt_btn = clrBlack;
   }

   if(Mostrar_Botao_Reset)
   {
      PBtn("btn_start", x + p, by, 200, 30, txt_btn, cor_btn, cor_txt_btn);
      PBtn("btn_reset", x + p + 200 + p, by, fw - 200 - p, 30, "RESETAR", Cor_Botao, clrWhite);
   }
   else
   {
      PBtn("btn_start", x + p, by, fw, 30, txt_btn, cor_btn, cor_txt_btn);
      ObjectDelete(0, "gt_btn_reset");
   }

   ChartRedraw(0);
}

