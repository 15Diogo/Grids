//+------------------------------------------------------------------+
//| Formatador R$ 25.432,10                                           |
//+------------------------------------------------------------------+
string FormatNum(double v)
{
   string s       = DoubleToString(MathAbs(v), 2);
   string inteiro = s;
   string dec     = "";
   int pos = StringFind(s, ".");
   if(pos >= 0)
   {
      inteiro = StringSubstr(s, 0, pos);
      dec     = StringSubstr(s, pos);
   }

   string fmt = "";
   int n = StringLen(inteiro);
   for(int i = 0; i < n; i++)
   {
      fmt += StringSubstr(inteiro, i, 1);
      int restante = n - i - 1;
      if(restante > 0 && restante % 3 == 0) fmt += ".";
   }

   if(dec == "") dec = ",00";
   else          dec = "," + StringSubstr(dec, 1);

   return fmt + dec;
}

//+------------------------------------------------------------------+
//| LÓGICA DE NEGOCIAÇÃO                                              |
//+------------------------------------------------------------------+
void PlaceInitialOrders()
{
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double orderVolume = (Volume == 0)
                        ? SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN)
                        : Volume;
   double tpPts = TakeProfit * pipValue;

   trade.Buy (orderVolume, _Symbol, ask, 0, ask + tpPts,
              EA_Comment + "_COMPRA");
   trade.Sell(orderVolume, _Symbol, bid, 0, bid - tpPts,
              EA_Comment + "_VENDA");

   lastOrderPrice = (ask + bid) / 2;
   initialOrdersPlaced = true;
}

void CheckForNewOrders()
{
   double mid  = (SymbolInfoDouble(_Symbol, SYMBOL_ASK) +
                 SymbolInfoDouble(_Symbol, SYMBOL_BID)) / 2;
   double dist = MathAbs(mid - lastOrderPrice) / pipValue;
   if(dist >= PipDistance) PlaceNewOrderPair(mid);
}

void PlaceNewOrderPair(double referencePrice)
{
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double orderVolume = (Volume == 0)
                        ? SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN)
                        : Volume;
   double tpPts = TakeProfit * pipValue;

   trade.Buy (orderVolume, _Symbol, ask, 0, ask + tpPts,
              EA_Comment + "_COMPRA");
   trade.Sell(orderVolume, _Symbol, bid, 0, bid - tpPts,
              EA_Comment + "_VENDA");

   lastOrderPrice = referencePrice;
}

void CheckExistingPositions()
{
   if(PositionsTotal() > 0)
   {
      double latestPrice = 0;
      datetime latestTime = 0;
      for(int i = 0; i < PositionsTotal(); i++)
      {
         if(position.SelectByIndex(i))
         {
            if(position.Symbol() == _Symbol && position.Magic() == MagicNumber)
            {
               if(position.Time() > latestTime)
               {
                  latestTime  = position.Time();
                  latestPrice = position.PriceOpen();
               }
            }
         }
      }
      if(latestPrice > 0)
      {
         lastOrderPrice = latestPrice;
         initialOrdersPlaced = true;
      }
   }
}

void CloseAllOrders()
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(position.SelectByIndex(i))
      {
         if(position.Symbol() == _Symbol && position.Magic() == MagicNumber)
            trade.PositionClose(position.Ticket());
      }
   }
   initialOrdersPlaced = false;
}

double CalculateLotSize()
{
   double minLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double maxLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double stepLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   if(Volume == 0) return minLot;

   double lot = Volume;
   lot = MathMax(minLot, lot);
   lot = MathMin(maxLot, lot);
   lot = MathRound(lot / stepLot) * stepLot;
   return lot;
}
