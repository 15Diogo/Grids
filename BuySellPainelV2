//+------------------------------------------------------------------+
//| ATUALIZAÇÃO DINÂMICA                                              |
//+------------------------------------------------------------------+
void UpdatePanel()
{
   ThemeColors C = GetColors();

   double initialBal = 25000.0;
   double balance    = AccountInfoDouble(ACCOUNT_BALANCE);
   double equity     = AccountInfoDouble(ACCOUNT_EQUITY);
   double profitHist = equity - initialBal;

   int    total = 0, buy = 0, sell = 0;
   double profit = 0.0;
   for(int i = 0; i < PositionsTotal(); i++)
   {
      if(position.SelectByIndex(i))
      {
         if(position.Symbol() == _Symbol && position.Magic() == MagicNumber)
         {
            total++;
            profit += position.Profit() + position.Swap() + position.Commission();
            if(position.PositionType() == POSITION_TYPE_BUY) buy++;
            else sell++;
         }
      }
   }

   double dd = 0;
   if(balance > 0) dd = ((balance - equity) / balance) * 100.0;

   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double spr = (ask - bid) / pipValue;

   // Fundo do painel repintado (para reagir à troca de tema)
   ObjectSetInteger(0, "GP_BG", OBJPROP_BGCOLOR, C.bgMain);
   ObjectSetInteger(0, "GP_BG", OBJPROP_COLOR,    C.border);

   // Saldo
   ObjectSetString (0, "GP_Saldo_Val", OBJPROP_TEXT, "R$ " + FormatNum(balance));
   ObjectSetInteger(0, "GP_Saldo_Val", OBJPROP_COLOR, C.textValue);

   // Equity
   ObjectSetString (0, "GP_Equity_Val", OBJPROP_TEXT, "R$ " + FormatNum(equity));
   ObjectSetInteger(0, "GP_Equity_Val", OBJPROP_COLOR,
                    (equity >= balance ? C.textPositive : C.textNegative));

   // Lucro flutuante
   string lfSign = (profit >= 0 ? "+ " : "");
   ObjectSetString (0, "GP_LF_Val", OBJPROP_TEXT,
                    lfSign + "R$ " + FormatNum(profit));
   ObjectSetInteger(0, "GP_LF_Val", OBJPROP_COLOR,
                    (profit >= 0 ? C.textPositive : C.textNegative));

   // Lucro histórico
   string lhSign = (profitHist >= 0 ? "+ " : "");
   ObjectSetString (0, "GP_LH_Val", OBJPROP_TEXT,
                    lhSign + "R$ " + FormatNum(profitHist));
   ObjectSetInteger(0, "GP_LH_Val", OBJPROP_COLOR,
                    (profitHist >= 0 ? C.textPositive : C.textNegative));

   // Ordens / compras / vendas
   ObjectSetString(0, "GP_Ordens_Val", OBJPROP_TEXT, IntegerToString(total));
   ObjectSetString(0, "GP_Buy_Val",    OBJPROP_TEXT, IntegerToString(buy));
   ObjectSetString(0, "GP_Sell_Val",   OBJPROP_TEXT, IntegerToString(sell));

   // Drawdown
   color ddColor = (dd > 5.0 ? C.textNegative :
                   (dd > 2.0 ? C.textWarning  : C.textPositive));
   ObjectSetString (0, "GP_DD_Val", OBJPROP_TEXT, DoubleToString(dd, 1) + "%");
   ObjectSetInteger(0, "GP_DD_Val", OBJPROP_COLOR, ddColor);

   // Spread
   ObjectSetString (0, "GP_Spr_Val", OBJPROP_TEXT, DoubleToString(spr, 1) + " pips");
   ObjectSetInteger(0, "GP_Spr_Val", OBJPROP_COLOR, C.textValue);

   // Status
   if(total > 0)
   {
      ObjectSetString (0, "GP_Status_V", OBJPROP_TEXT, "OPERANDO");
      ObjectSetInteger(0, "GP_Status_V", OBJPROP_COLOR, C.textPositive);
   }
   else
   {
      ObjectSetString (0, "GP_Status_V", OBJPROP_TEXT, "AGUARDANDO");
      ObjectSetInteger(0, "GP_Status_V", OBJPROP_COLOR, C.textWarning);
   }

   // Botão REINICIAR (cor constante do tema)
   ObjectSetInteger(0, "GP_ReinitBG", OBJPROP_BGCOLOR, C.btnBg);
   ObjectSetInteger(0, "GP_ReinitBG", OBJPROP_COLOR,    C.btnBg);
   UpdateBtnColors("GridPanel_ReinitBtn", C.btnBg, C.btnText);

   // Botão TEMA (cor neutra do tema)
   UpdateBtnColors("GridPanel_ThemeBtn", C.btnNeutralBg, C.btnNeutralText);
}

