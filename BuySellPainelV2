string GetSymbolDesc()
{
   string d=SymbolInfoString(_Symbol,SYMBOL_DESCRIPTION);
   if(StringLen(d)>18) d=StringSubstr(d,0,18)+"...";
   if(StringLen(d)==0) d=_Symbol;
   return d;
}

//+------------------------------------------------------------------+
//| Formatador: 25432.10  →  "25.432,10"                             |
//+------------------------------------------------------------------+
string FmtN(double v)
{
   string s=DoubleToString(MathAbs(v),2);
   string inteiro=s, dec="";
   int pos=StringFind(s,".");
   if(pos>=0){ inteiro=StringSubstr(s,0,pos); dec=StringSubstr(s,pos); }
   string fmt="";
   int n=StringLen(inteiro);
   for(int i=0;i<n;i++)
   {
      fmt+=StringSubstr(inteiro,i,1);
      int r=n-i-1;
      if(r>0 && r%3==0) fmt+=".";
   }
   dec=(dec=="")?",00":(","+StringSubstr(dec,1));
   return (v<0?"-":"")+fmt+dec;
}

//+------------------------------------------------------------------+
//| LÓGICA DE NEGOCIAÇÃO                                              |
//+------------------------------------------------------------------+
void PlaceInitialOrders()
{
   double ask=SymbolInfoDouble(_Symbol,SYMBOL_ASK);
   double bid=SymbolInfoDouble(_Symbol,SYMBOL_BID);
   double lot=CalculateLotSize();
   double tp =TakeProfit*pipValue;

   trade.Buy (lot,_Symbol,ask,0,ask+tp,EA_Comment+"_COMPRA");
   trade.Sell(lot,_Symbol,bid,0,bid-tp,EA_Comment+"_VENDA");

   lastOrderPrice=(ask+bid)/2.0;
   initialOrdersPlaced=true;
}

void CheckForNewOrders()
{
   double mid=(SymbolInfoDouble(_Symbol,SYMBOL_ASK)+
               SymbolInfoDouble(_Symbol,SYMBOL_BID))/2.0;
   if(MathAbs(mid-lastOrderPrice)/pipValue >= PipDistance)
      PlaceNewOrderPair(mid);
}

void PlaceNewOrderPair(double ref)
{
   double ask=SymbolInfoDouble(_Symbol,SYMBOL_ASK);
   double bid=SymbolInfoDouble(_Symbol,SYMBOL_BID);
   double lot=CalculateLotSize();
   double tp =TakeProfit*pipValue;

   trade.Buy (lot,_Symbol,ask,0,ask+tp,EA_Comment+"_COMPRA");
   trade.Sell(lot,_Symbol,bid,0,bid-tp,EA_Comment+"_VENDA");

   lastOrderPrice=ref;
}

void CheckExistingPositions()
{
   double latP=0; datetime latT=0;
   for(int i=0;i<PositionsTotal();i++)
   {
      if(position.SelectByIndex(i))
      {
         if(position.Symbol()==_Symbol && position.Magic()==MagicNumber)
            if(position.Time()>latT){ latT=position.Time(); latP=position.PriceOpen(); }
      }
   }
   if(latP>0){ lastOrderPrice=latP; initialOrdersPlaced=true; }
}

void CloseAllOrders()
{
   for(int i=PositionsTotal()-1;i>=0;i--)
   {
      if(position.SelectByIndex(i))
         if(position.Symbol()==_Symbol && position.Magic()==MagicNumber)
            trade.PositionClose(position.Ticket());
   }
}

double CalculateLotSize()
{
   double mn=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MIN);
   double mx=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MAX);
   double st=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_STEP);
   if(Volume==0) return mn;
   double lot=MathMax(mn,MathMin(mx,Volume));
   return MathRound(lot/st)*st;
}
