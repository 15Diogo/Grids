//+------------------------------------------------------------------+
//| APLICAR CORES NO GRÁFICO                                          |
//+------------------------------------------------------------------+
void ApplyChartTheme()
{
   if(!ApplyChartColors) return;
   ThemeColors C = GetColors();
   ChartSetInteger(0, CHART_COLOR_BACKGROUND,  C.chartBg);
   ChartSetInteger(0, CHART_COLOR_FOREGROUND,  C.chartFg);
   ChartSetInteger(0, CHART_COLOR_GRID,        C.chartGrid);
   ChartSetInteger(0, CHART_COLOR_CHART_UP,    C.candleBull);
   ChartSetInteger(0, CHART_COLOR_CHART_DOWN,  C.candleBear);
   ChartSetInteger(0, CHART_COLOR_CHART_LINE,  C.candleLine);
   ChartSetInteger(0, CHART_COLOR_CANDLE_BULL, C.candleBull);
   ChartSetInteger(0, CHART_COLOR_CANDLE_BEAR, C.candleBear);
   ChartSetInteger(0, CHART_COLOR_VOLUME,      C.volume);
   ChartSetInteger(0, CHART_COLOR_BID,         C.textLabel);
   ChartSetInteger(0, CHART_COLOR_ASK,         C.textLabel);
   ChartSetInteger(0, CHART_COLOR_LAST,        C.textValue);
   ChartSetInteger(0, CHART_COLOR_STOP_LEVEL,  C.textWarning);
   ChartSetInteger(0, CHART_SHOW_GRID,         true);
   ChartRedraw(0);
}

//+------------------------------------------------------------------+
//| INIT / DEINIT / TICK                                              |
//+------------------------------------------------------------------+
int OnInit()
{
   trade.SetExpertMagicNumber(MagicNumber);

   pipValue = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   if(SymbolInfoInteger(_Symbol, SYMBOL_DIGITS) == 5 ||
      SymbolInfoInteger(_Symbol, SYMBOL_DIGITS) == 3)
      pipValue *= 10;

   currentTheme = Theme;

   CheckExistingPositions();
   ApplyChartTheme();

   if(ShowPanel) CreateFullPanel();

   Print("Grid EA v3.10 iniciado | Tema: ",
         (currentTheme == THEME_LIGHT ? "Claro" : "Escuro"));
   return INIT_SUCCEEDED;
}

void OnDeinit(const int reason)
{
   if(ShowPanel) RemovePanel();
}

void OnTick()
{
   if(!initialOrdersPlaced)
   {
      PlaceInitialOrders();
      return;
   }

   CheckForNewOrders();

   if(ShowPanel) UpdateFullPanel();
}

//+------------------------------------------------------------------+
//| EVENTOS DE CLIQUE                                                 |
//+------------------------------------------------------------------+
void OnChartEvent(const int id, const long &lparam,
                  const double &dparam, const string &sparam)
{
   if(id != CHARTEVENT_OBJECT_CLICK) return;

   if(sparam == "GP_BtnTheme_BTN")
   {
      ToggleTheme();
      ObjectSetInteger(0, "GP_BtnTheme_BTN", OBJPROP_STATE, false);
   }
   else if(sparam == "GP_SecConta_BTN")
   {
      secConta = !secConta;
      ObjectSetInteger(0, sparam, OBJPROP_STATE, false);
      RedrawSidePanel();
   }
   else if(sparam == "GP_SecPos_BTN")
   {
      secPos = !secPos;
      ObjectSetInteger(0, sparam, OBJPROP_STATE, false);
      RedrawSidePanel();
   }
   else if(sparam == "GP_SecManual_BTN")
   {
      secManual = !secManual;
      ObjectSetInteger(0, sparam, OBJPROP_STATE, false);
      RedrawSidePanel();
   }
   else if(sparam == "GP_SecControl_BTN")
   {
      secControl = !secControl;
      ObjectSetInteger(0, sparam, OBJPROP_STATE, false);
      RedrawSidePanel();
   }
}

//+------------------------------------------------------------------+
//| ALTERNAR TEMA                                                     |
//+------------------------------------------------------------------+
void ToggleTheme()
{
   currentTheme = (currentTheme == THEME_DARK) ? THEME_LIGHT : THEME_DARK;
   RemovePanel();
   ApplyChartTheme();
   CreateFullPanel();
   UpdateFullPanel();
   Print("Tema: ", (currentTheme == THEME_LIGHT ? "Claro" : "Escuro"));
}

//+------------------------------------------------------------------+
//| PAINEL COMPLETO                                                   |
//+------------------------------------------------------------------+
void CreateFullPanel()
{
   CreateTopBar();
   CreateSidePanel();
   CreateThemeButton();
}

//+------------------------------------------------------------------+
//| BARRA SUPERIOR FULL-WIDTH — 5 blocos de largura igual             |
//|  Todos os blocos usam o MESMO grid interno para evitar acúmulo:   |
//|    y=5   título (font 8, Arial Bold, C.textLabel)                 |
//|    y=22  valor principal (font 12, Arial Black, C.textValue)      |
//|    y=48  sublinha 1  → label em x+PAD, valor em x+PAD+VC         |
//|    y=66  sublinha 2  → label em x+PAD, valor em x+PAD+VC         |
//|  TOP_H=88  →  66+10(font) = 76 < 88  OK                          |
//|  VC=90 = offset uniforme label→valor em todos os blocos           |
//+------------------------------------------------------------------+
void CreateTopBar()
{
   ThemeColors C = GetColors();
   int W = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);

   MkRect("GP_TopBG", 0, 0, W, TOP_H, C.topBg, C.topBg, 0);

   int bw  = W / 5;
   int bw5 = W - bw * 4;
   int VC  = 90; // offset uniforme label -> valor (todos os blocos)

   // ---- BLOCO 1 : ATIVO ----
   int bx = 0;
   MkRect("GP_B1bg",  bx, 0, bw, TOP_H, C.topBlockBg, C.topBlockBorder, 1);
   MkLbl("GP_B1_tit", "ATIVO",        bx+PAD,    5, 8,  C.textLabel,   "Arial Bold");
   MkLbl("GP_B1_sym", _Symbol,         bx+PAD,   22, 12, C.textValue,   "Arial Black");
   MkLbl("GP_B1_nl",  "NOME:",        bx+PAD,   48, 8,  C.textLabel,   "Arial Bold");
   MkLbl("GP_B1_nv",  GetSymbolDesc(),bx+PAD+VC, 48, 8,  C.textValue,  "Arial Bold");
   MkLbl("GP_B1_sl",  "STATUS:",      bx+PAD,   66, 8,  C.textLabel,   "Arial Bold");
   MkLbl("GP_B1_sv",  "OPERANDO",     bx+PAD+VC, 66, 9,  C.textPositive,"Arial Black");

   // ---- BLOCO 2 : CONTA ----
   bx = bw;
   MkRect("GP_B2bg",  bx, 0, bw, TOP_H, C.topBlockBg, C.topBlockBorder, 1);
   MkLbl("GP_B2_tit", "CONTA",        bx+PAD,    5, 8,  C.textLabel,  "Arial Bold");
   MkLbl("GP_B2_bal", "R$ 0,00",      bx+PAD,   22, 12, C.textValue,  "Arial Black");
   MkLbl("GP_B2_el",  "EQUITY:",      bx+PAD,   48, 8,  C.textPositive,"Arial Bold"); // Letras verdes
   MkLbl("GP_B2_ev",  "R$ 0,00",      bx+PAD+VC, 48, 8,  C.textPositive,"Arial Bold");

   // ---- BLOCO 3 : DESEMPENHO ----
   bx = bw * 2;
   MkRect("GP_B3bg",  bx, 0, bw, TOP_H, C.topBlockBg, C.topBlockBorder, 1);
   MkLbl("GP_B3_tit", "DESEMPENHO",   bx+PAD,    5, 8,  C.textLabel,  "Arial Bold");
   MkLbl("GP_B3_bal", "R$ 0,00",      bx+PAD,   22, 12, C.textPositive,"Arial Black");
   MkLbl("GP_B3_dyl", "DIARIO:",      bx+PAD,   48, 8,  C.textLabel,  "Arial Bold");
   MkLbl("GP_B3_dyv", "R$ 0,00",      bx+PAD+VC, 48, 8,  C.textPositive,"Arial Bold");

   // ---- BLOCO 4 : RISCO ----
   bx = bw * 3;
   MkRect("GP_B4bg",  bx, 0, bw, TOP_H, C.topBlockBg, C.topBlockBorder, 1);
   MkLbl("GP_B4_tit", "RISCO",        bx+PAD,    5, 8,  C.textLabel,  "Arial Bold");
   MkLbl("GP_B4_ddv", "0.0%",         bx+PAD,   22, 12, C.textWarning,"Arial Black");
   MkLbl("GP_B4_mhl", "DD MAX:",      bx+PAD,   48, 8,  C.textLabel,  "Arial Bold");
   MkLbl("GP_B4_mhv", "0.0%",         bx+PAD+VC, 48, 8,  C.textNegative,"Arial Bold");
   MkLbl("GP_B4_spl", "SPREAD:",      bx+PAD,   66, 8,  C.textLabel,  "Arial Bold");
   MkLbl("GP_B4_spv", "0.0 pips",     bx+PAD+VC, 66, 8,  C.textValue, "Arial Bold");

   // ---- BLOCO 5 : MERCADO ----
   bx = bw * 4;
   MkRect("GP_B5bg",  bx, 0, bw5, TOP_H, C.topBlockBg, C.topBlockBorder, 1);
   MkLbl("GP_B5_tit", "MERCADO",      bx+PAD,    5, 8,  C.textLabel,  "Arial Bold");
   MkLbl("GP_B5_ov",  "0",            bx+PAD,   22, 12, C.textValue,  "Arial Black");
   MkLbl("GP_B5_cl",  "COMPRAS:",     bx+PAD,   48, 8,  C.textBuy,   "Arial Bold");
   MkLbl("GP_B5_cv",  "0",            bx+PAD+VC, 48, 9,  C.textBuy,  "Arial Black");
   MkLbl("GP_B5_vl",  "VENDAS:",      bx+PAD,   66, 8,  C.textSell,  "Arial Bold");
   MkLbl("GP_B5_vv",  "0",            bx+PAD+VC, 66, 9,  C.textSell, "Arial Black");
}

//+------------------------------------------------------------------+
//| PAINEL LATERAL — esquerda, abaixo da barra                        |
//+------------------------------------------------------------------+
void CreateSidePanel()
{
   ThemeColors C = GetColors();
   int totalH = CalcSidePanelH();
   MkRect("GP_SideBG", SIDE_X, SIDE_Y, SIDE_W, totalH, C.bgMain, C.border, 1);

   int y = SIDE_Y + 1;

   // === INFORMAÇÕES DA CONTA ===
   y = DrawSecHdr("GP_SecConta", "INFORMACOES DA CONTA", y, secConta);
   if(secConta)
   {
      y = DrawRow("GP_S_bal",  "SALDO:",            "R$ 0,00", y, true);
      y = DrawRow("GP_S_eq",   "EQUITY:",           "R$ 0,00", y, false, C.textPositive);
      y = DrawRow("GP_S_luh",  "Lucro Diario:",     "R$ 0,00", y, true);
   }

   // === POSIÇÕES ATIVAS ===
   y = DrawSecHdr("GP_SecPos", "POSICOES ATIVAS", y, secPos);
   if(secPos)
   {
      y = DrawPosTableHdr(y);
      for(int i = 0; i < 4; i++)
         y = DrawPosTableRow(i, "", "", "", "", y, (i%2==0));
   }

   // === ORDENS MANUAIS ===
   y = DrawSecHdr("GP_SecManual", "ORDENS MANUAIS", y, secManual);
   if(secManual)
   {
      y = DrawManHdr(y);
      for(int i = 0; i < 2; i++)
         y = DrawManRow(i, "", "", "", y, (i%2==0));
   }

   // === CONTROLES & CONFIGURAÇÕES ===
   y = DrawSecHdr("GP_SecControl", "CONTROLES E CONFIGURACOES", y, secControl);
   if(secControl)
   {
      ThemeColors C2 = GetColors();
      y = DrawRow("GP_C_ea",    "Estrategia:",    "ATIVA",   y, true);
      y = DrawRow("GP_C_vol",   "Volume Lote:",   DoubleToString(Volume, 2), y, false);
      y = DrawRow("GP_C_tema",  "Tema atual:",    (currentTheme == THEME_DARK ? "ESCURO" : "CLARO"), y, true);
      y = DrawRow("GP_C_pip",   "Pip Dist.:",
                  IntegerToString(PipDistance) + " pips",  y, false);
      y = DrawRow("GP_C_tp",    "Take Profit:",
                  IntegerToString(TakeProfit) + " pips",   y, true);
   }
}

//+------------------------------------------------------------------+
//| BOTÃO ALTERAR TEMA — canto superior direito do painel lateral     |
//+------------------------------------------------------------------+
void CreateThemeButton()
{
   ThemeColors C = GetColors();
   // Posicionado no canto inferior do painel, ou como botão flutuante
   int chartW = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
   int bw = 130;
   int bh = 30;
   int bx = chartW - bw - 8;
   int by = TOP_H + 8;
   MkBtn("GP_BtnTheme",
         (currentTheme==THEME_DARK ? "TEMA CLARO" : "TEMA ESCURO"),
         bx, by, bw, bh, C.btnThemeBg, C.btnThemeText);
}

//+------------------------------------------------------------------+
//| REDESENHO DO PAINEL LATERAL (collapse/expand)                     |
//+------------------------------------------------------------------+
void RedrawSidePanel()
{
   // Apaga apenas objetos do painel lateral
   ObjectsDeleteAll(0, "GP_SideBG");
   ObjectsDeleteAll(0, "GP_Sec");
   ObjectsDeleteAll(0, "GP_S_");
   ObjectsDeleteAll(0, "GP_C_");
   ObjectsDeleteAll(0, "GP_PosH");
   ObjectsDeleteAll(0, "GP_PosR");
   ObjectsDeleteAll(0, "GP_ManH");
   ObjectsDeleteAll(0, "GP_ManR");
   CreateSidePanel();
   UpdateFullPanel();
   ChartRedraw(0);
}

//+------------------------------------------------------------------+
//| HELPERS DE LAYOUT                                                 |
//+------------------------------------------------------------------+
int CalcSidePanelH()
{
   int h = 2;
   h += SECTION_H; if(secConta)   h += ROW_H * 3;
   h += SECTION_H; if(secPos)     h += ROW_H + ROW_H * 4;
   h += SECTION_H; if(secManual)  h += ROW_H + ROW_H * 2;
   h += SECTION_H; if(secControl) h += ROW_H * 5;
   return h;
}

// Cabeçalho de seção com botão colapso
int DrawSecHdr(string pfx, string title, int y, bool expanded)
{
   ThemeColors C = GetColors();
   MkRect(pfx+"_BG",  SIDE_X, y, SIDE_W, SECTION_H, C.bgSection, C.separator, 0);
   MkLbl (pfx+"_Lbl", title, SIDE_X+PAD, y+5, 9, C.textHeader, "Arial Bold");
   MkBtn (pfx, (expanded?"v":"^"), SIDE_X+SIDE_W-24, y+2, 22, SECTION_H-4,
          C.bgSection, C.textLabel);
   return y + SECTION_H;
}

// Linha de dado — label esquerda + valor na coluna VAL_X (alinhamento fixo)
int DrawRow(string pfx, string lbl, string val, int y, bool alt, color lblColor=clrNONE)
{
   ThemeColors C = GetColors();
   if(lblColor == clrNONE) lblColor = C.textLabel;
   color bg = alt ? C.bgRowAlt : C.bgRow;
   int yc   = y + (ROW_H - 9) / 2;   // centra verticalmente (font 9)
   MkRect(pfx+"_BG", SIDE_X,   y, SIDE_W, ROW_H, bg, C.separator, 0);
   MkLbl (pfx+"_L",  lbl,  SIDE_X+PAD,   yc, 9, lblColor, "Arial Bold");
   MkLbl (pfx+"_V",  val,  SIDE_X+VAL_X, yc, 9, C.textValue, "Arial Black");
   return y + ROW_H;
}

// Cabeçalho da tabela de posições
// Colunas: Tipo | Ativo | Volume | Max
int DrawPosTableHdr(int y)
{
   ThemeColors C = GetColors();
   int yc = y + (ROW_H - 8) / 2;
   MkRect("GP_PosH_BG", SIDE_X, y, SIDE_W, ROW_H, C.bgSection, C.separator, 0);
   MkLbl ("GP_PosH_T",  "Tipo",    SIDE_X+PAD,  yc, 8, C.textLabel, "Arial Bold");
   MkLbl ("GP_PosH_A",  "Ativo",   SIDE_X+100,  yc, 8, C.textLabel, "Arial Bold");
   MkLbl ("GP_PosH_L",  "Volume",  SIDE_X+168,  yc, 8, C.textLabel, "Arial Bold");
   MkLbl ("GP_PosH_M",  "Max",     SIDE_X+244,  yc, 8, C.textLabel, "Arial Bold");
   return y + ROW_H;
}

int DrawPosTableRow(int idx, string tipo, string ativo, string vol, string max, int y, bool alt)
{
   string p = "GP_PosR"+IntegerToString(idx);
   ThemeColors C = GetColors();
   color bg  = alt ? C.bgRowAlt : C.bgRow;
   color tc  = (tipo=="COMPRAS") ? C.textBuy : (tipo=="VENDAS" ? C.textSell : C.textLabel);
   int yc = y + (ROW_H - 8) / 2;
   MkRect(p+"_BG", SIDE_X, y, SIDE_W, ROW_H, bg, C.separator, 0);
   MkLbl (p+"_T",  tipo==""?" ":tipo,   SIDE_X+PAD,  yc, 8, tc,          "Arial Bold");
   MkLbl (p+"_A",  ativo==""?" ":ativo,  SIDE_X+100,  yc, 8, C.textValue, "Arial");
   MkLbl (p+"_L",  vol==""?" ":vol,    SIDE_X+168,  yc, 8, C.textValue, "Arial");
   MkLbl (p+"_M",  max==""?" ":max,    SIDE_X+244,  yc, 8, C.textLabel, "Arial");
   return y + ROW_H;
}

int DrawManHdr(int y)
