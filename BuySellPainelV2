   ThemeColors C = GetColors();
   int yc = y + (ROW_H - 8) / 2;
   MkRect("GP_ManH_BG", SIDE_X, y, SIDE_W, ROW_H, C.bgSection, C.separator, 0);
   MkLbl ("GP_ManH_T",  "Tipo",   SIDE_X+PAD, yc, 8, C.textLabel, "Arial Bold");
   MkLbl ("GP_ManH_A",  "Ativo",  SIDE_X+95,  yc, 8, C.textLabel, "Arial Bold");
   MkLbl ("GP_ManH_V",  "Volume", SIDE_X+200, yc, 8, C.textLabel, "Arial Bold");
   return y + ROW_H;
}

int DrawManRow(int idx, string tipo, string ativo, string vol, int y, bool alt)
{
   string p = "GP_ManR"+IntegerToString(idx);
   ThemeColors C = GetColors();
   color bg = alt ? C.bgRowAlt : C.bgRow;
   color tc = (tipo=="COMPRA") ? C.textBuy : (tipo=="VENDA" ? C.textSell : C.textLabel);
   int yc = y + (ROW_H - 8) / 2;
   MkRect(p+"_BG", SIDE_X, y, SIDE_W, ROW_H, bg, C.separator, 0);
   MkLbl (p+"_T",  tipo==""?" ":tipo,   SIDE_X+PAD, yc, 8, tc,          "Arial Bold");
   MkLbl (p+"_A",  ativo==""?" ":ativo,  SIDE_X+95,  yc, 8, C.textValue, "Arial");
   MkLbl (p+"_V",  vol==""?" ":vol,    SIDE_X+200, yc, 8, C.textValue, "Arial");
   return y + ROW_H;
}

//+------------------------------------------------------------------+
//| LUCRO DIÁRIO — soma dos deals fechados hoje                       |
//| Usa HistorySelect para pegar apenas os deals do dia corrente.      |
//+------------------------------------------------------------------+
double CalcDailyProfit()
{
   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);
   dt.hour = 0; dt.min = 0; dt.sec = 0;
   datetime dayStart = StructToTime(dt);
   if(!HistorySelect(dayStart, TimeCurrent())) return 0.0;
   double closed = 0;
   int total = HistoryDealsTotal();
   for(int i = 0; i < total; i++)
   {
      ulong ticket = HistoryDealGetTicket(i);
      if(ticket == 0) continue;
      ENUM_DEAL_ENTRY entry = (ENUM_DEAL_ENTRY)HistoryDealGetInteger(ticket, DEAL_ENTRY);
      if(entry == DEAL_ENTRY_IN) continue;
      closed += HistoryDealGetDouble(ticket, DEAL_PROFIT)
              + HistoryDealGetDouble(ticket, DEAL_COMMISSION)
              + HistoryDealGetDouble(ticket, DEAL_SWAP);
   }
   return closed;
}

