//| ATUALIZAÇÃO DINÂMICA                                              |
//+------------------------------------------------------------------+
void UpdateFullPanel()
{
   ThemeColors C = GetColors();

   double balance  = AccountInfoDouble(ACCOUNT_BALANCE);
   double equity   = AccountInfoDouble(ACCOUNT_EQUITY);
   
   int    total=0, buys=0, sells=0;
   double profitF=0, maxLot=0;

   for(int i = 0; i < PositionsTotal(); i++)
   {
      if(position.SelectByIndex(i))
      {
         if(position.Symbol() == _Symbol && position.Magic() == MagicNumber)
         {
            total++;
            profitF += position.Profit() + position.Swap() + position.Commission();
            if(position.PositionType() == POSITION_TYPE_BUY)
               buys++;
            else
               sells++;
            if(position.Volume() > maxLot)
               maxLot = position.Volume();
         }
      }
   }

   double dd  = (balance>0) ? (balance-equity)/balance*100.0 : 0;
   double spr = (SymbolInfoDouble(_Symbol,SYMBOL_ASK)
                -SymbolInfoDouble(_Symbol,SYMBOL_BID)) / pipValue;
   double dailyP = CalcDailyProfit();

   //---- TOP BAR ----
   bool algoEnabled = (bool)TerminalInfoInteger(TERMINAL_TRADE_ALLOWED) && (bool)MQLInfoInteger(MQL_TRADE_ALLOWED);
   SetTxt("GP_B1_sv", algoEnabled ? "OPERANDO" : "MODO MONITOR");
   SetClr("GP_B1_sv", algoEnabled ? C.textPositive : C.textWarning);

   SetTxt("GP_B2_bal", "R$ "+FmtN(balance));
   SetClr("GP_B2_bal", balance >= 0 ? C.textPositive : C.textNegative);
   SetTxt("GP_B2_ev",  "R$ "+FmtN(equity));
   SetClr("GP_B2_ev",  equity >= 0 ? C.textPositive : C.textNegative);

   SetTxt("GP_B3_bal", (profitF>=0?"+":"")+"R$ "+FmtN(profitF));
   SetClr("GP_B3_bal", profitF>=0 ? C.textPositive : C.textNegative);
   SetTxt("GP_B3_dyv", (dailyP>=0?"+":"")+"R$ "+FmtN(dailyP));
   SetClr("GP_B3_dyv", dailyP>=0 ? C.textPositive : C.textNegative);

   color ddC = (dd>10.0 ? C.textNegative : (dd>5.0 ? C.textWarning : C.textPositive));
   SetTxt("GP_B4_ddv", DoubleToString(dd,1)+"%");  SetClr("GP_B4_ddv", ddC);
   SetTxt("GP_B4_mhv", DoubleToString(dd,1)+"%");  SetClr("GP_B4_mhv", C.textNegative);
   SetTxt("GP_B4_spv", DoubleToString(spr,1)+" pips");

   // Bloco 5
   SetTxt("GP_B5_ov", IntegerToString(total));
   SetTxt("GP_B5_cv", IntegerToString(buys));
   SetTxt("GP_B5_vv", IntegerToString(sells));

   //---- PAINEL LATERAL ----
   if(secConta)
   {
      SetTxt("GP_S_bal_V", "R$ " + FmtN(balance));
      SetClr("GP_S_bal_V", balance >= 0 ? C.textPositive : C.textNegative);
      SetTxt("GP_S_eq_V",  "R$ " + FmtN(equity));
      SetClr("GP_S_eq_V",  equity >= 0 ? C.textPositive : C.textNegative);
      SetTxt("GP_S_luh_V", (dailyP >= 0 ? "+" : "") + "R$ " + FmtN(dailyP));
      SetClr("GP_S_luh_V", dailyP >= 0 ? C.textPositive : C.textNegative);
   }

   if(secPos)
   {
      // linha 0 — compras
      if(buys > 0)
      {
         SetTxt("GP_PosR0_T", "COMPRAS: " + IntegerToString(buys));
         SetClr("GP_PosR0_T", C.textBuy);
         SetTxt("GP_PosR0_A", _Symbol);
         SetTxt("GP_PosR0_L", DoubleToString(Volume * buys, 2) + " Lts");
         SetTxt("GP_PosR0_M", DoubleToString(maxLot, 2));
      }
      else
      {
         SetTxt("GP_PosR0_T", " ");
         SetTxt("GP_PosR0_A", " ");
         SetTxt("GP_PosR0_L", " ");
         SetTxt("GP_PosR0_M", " ");
      }
 
      // linha 1 — vendas
      if(sells > 0)
      {
         SetTxt("GP_PosR1_T", "VENDAS: " + IntegerToString(sells));
         SetClr("GP_PosR1_T", C.textSell);
         SetTxt("GP_PosR1_A", _Symbol);
         SetTxt("GP_PosR1_L", DoubleToString(Volume * sells, 2) + " Lts");
         SetTxt("GP_PosR1_M", DoubleToString(maxLot, 2));
      }
      else
      {
         SetTxt("GP_PosR1_T", " ");
         SetTxt("GP_PosR1_A", " ");
         SetTxt("GP_PosR1_L", " ");
         SetTxt("GP_PosR1_M", " ");
      }

      // linha 2 — lucro
      SetTxt("GP_PosR2_T", "LUCRO:");
      SetClr("GP_PosR2_T", C.textLabel);
      SetTxt("GP_PosR2_A", " ");
      SetTxt("GP_PosR2_L", "R$ "+FmtN(profitF));
      SetClr("GP_PosR2_L", profitF>=0 ? C.textPositive : C.textNegative);
      SetTxt("GP_PosR2_M", " ");

      // linha 3 vazia
      SetTxt("GP_PosR3_T", " ");
      SetTxt("GP_PosR3_A", " ");
      SetTxt("GP_PosR3_L", " ");
      SetTxt("GP_PosR3_M", " ");
   }

   if(secManual)
   {
      int mi=0;
      for(int i=0; i<PositionsTotal() && mi<2; i++)
      {
         if(position.SelectByIndex(i))
         {
            if(position.Symbol()==_Symbol && position.Magic()!=MagicNumber)
            {
               string tp=(position.PositionType()==POSITION_TYPE_BUY)?"COMPRA":"VENDA";
               SetTxt("GP_ManR"+IntegerToString(mi)+"_T", tp);
               SetClr("GP_ManR"+IntegerToString(mi)+"_T", (tp=="COMPRA")?C.textBuy:C.textSell);
               SetTxt("GP_ManR"+IntegerToString(mi)+"_A", position.Symbol()+" (M)");
               SetTxt("GP_ManR"+IntegerToString(mi)+"_V", DoubleToString(position.Volume(),2)+" Lts");
               mi++;
            }
         }
      }
      for(int i = mi; i < 2; i++)
      {
         SetTxt("GP_ManR" + IntegerToString(i) + "_T", " ");
         SetTxt("GP_ManR" + IntegerToString(i) + "_A", " ");
         SetTxt("GP_ManR" + IntegerToString(i) + "_V", " ");
      }
   }

   if(secControl)
   {
      SetTxt("GP_C_ea_V",   "ATIVA");
      SetClr("GP_C_ea_V",   C.textPositive);
      SetTxt("GP_C_tema_V", (currentTheme==THEME_DARK?"ESCURO":"CLARO"));
   }

   // Botão TEMA
   SetTxt("GP_BtnTheme_BTN", (currentTheme==THEME_DARK?"TEMA CLARO":"TEMA ESCURO"));

   ChartRedraw(0);
}

