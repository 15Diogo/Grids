//+------------------------------------------------------------------+
//| APLICAR CORES DO TEMA NO GRÁFICO                                  |
//+------------------------------------------------------------------+
void ApplyChartTheme()
{
   if(!ApplyChartColors) return;

   ThemeColors C = GetColors();
   long chart = 0;

   ChartSetInteger(chart, CHART_COLOR_BACKGROUND,   C.chartBg);
   ChartSetInteger(chart, CHART_COLOR_FOREGROUND,   C.chartFg);
   ChartSetInteger(chart, CHART_COLOR_GRID,         C.chartGrid);
   ChartSetInteger(chart, CHART_COLOR_CHART_UP,     C.candleBull);
   ChartSetInteger(chart, CHART_COLOR_CHART_DOWN,   C.candleBear);
   ChartSetInteger(chart, CHART_COLOR_CHART_LINE,   C.candleLine);
   ChartSetInteger(chart, CHART_COLOR_CANDLE_BULL,  C.candleBull);
   ChartSetInteger(chart, CHART_COLOR_CANDLE_BEAR,  C.candleBear);
   ChartSetInteger(chart, CHART_COLOR_VOLUME,       C.volume);
   ChartSetInteger(chart, CHART_COLOR_BID,          C.textLabel);
   ChartSetInteger(chart, CHART_COLOR_ASK,          C.textLabel);
   ChartSetInteger(chart, CHART_COLOR_LAST,         C.textValue);
   ChartSetInteger(chart, CHART_COLOR_STOP_LEVEL,   C.textWarning);
   ChartSetInteger(chart, CHART_SHOW_GRID,          true);

   ChartRedraw(chart);
}

//+------------------------------------------------------------------+
//| INITIALIZATION / DEINIT / TICK                                    |
//+------------------------------------------------------------------+
int OnInit()
{
   trade.SetExpertMagicNumber(MagicNumber);

   pipValue = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   if(SymbolInfoInteger(_Symbol, SYMBOL_DIGITS) == 5 ||
      SymbolInfoInteger(_Symbol, SYMBOL_DIGITS) == 3)
      pipValue *= 10;

   currentTheme = Theme;

   CheckExistingPositions();

   ApplyChartTheme();

   if(ShowPanel)
      CreatePanel();

   Print("Grid EA v2.20 iniciado | Tema: ",
         (currentTheme==THEME_LIGHT ? "Claro" : "Escuro"));
   return(INIT_SUCCEEDED);
}

void OnDeinit(const int reason)
{
   if(ShowPanel)
      RemovePanel();
}

void OnTick()
{
   if(!initialOrdersPlaced)
   {
      PlaceInitialOrders();
      return;
   }

   CheckForNewOrders();

   if(ShowPanel)
      UpdatePanel();
}

//+------------------------------------------------------------------+
//| TRATAMENTO DE CLIQUES                                             |
//+------------------------------------------------------------------+
void OnChartEvent(const int id, const long &lparam,
                  const double &dparam, const string &sparam)
{
   if(id != CHARTEVENT_OBJECT_CLICK) return;

   if(sparam == "GridPanel_ThemeBtn_BTN")
   {
      ToggleTheme();
      ObjectSetInteger(0, "GridPanel_ThemeBtn_BTN", OBJPROP_STATE, false);
   }
   else if(sparam == "GridPanel_ReinitBtn_BTN")
   {
      CloseAllOrders();
      ObjectSetInteger(0, "GridPanel_ReinitBtn_BTN", OBJPROP_STATE, false);
   }
}

//+------------------------------------------------------------------+
//| ALTERNAR TEMA                                                     |
//+------------------------------------------------------------------+
void ToggleTheme()
{
   currentTheme = (currentTheme == THEME_DARK) ? THEME_LIGHT : THEME_DARK;
   RemovePanel();
   ApplyChartTheme();
   CreatePanel();
   UpdatePanel();
   Print("Tema alterado para: ",
         (currentTheme==THEME_LIGHT ? "Claro" : "Escuro"));
}

//+------------------------------------------------------------------+
//| CRIAÇÃO DO PAINEL — FINO, LARGO, HORIZONTAL                       |
//+------------------------------------------------------------------+
void CreatePanel()
{
   ThemeColors C = GetColors();

   int W = PanelWidth;
   int H = PanelHeight;

   // Bloco do botão REINICIAR à direita
   int btnW = 150;
   // Bloco do seletor de tema à direita do botão? Não – colocamos AO LADO
   int themeW = 110;
   int gap    = 6;

   // Área de dados = largura total menos os dois botões e paddings
   int dataArea = W - btnW - themeW - gap*3;
   // 5 colunas de dados
   int colW = dataArea / 5;

   // === Fundo principal ===
   CreateRect("GP_BG", PanelX, PanelY, W, H, C.bgMain, C.border, 1);

   // === Coordenadas verticais compactas ===
   int yLabel = PanelY + 10;   // rótulo (topo)
   int yValue = PanelY + 26;   // valor principal
   int yLabel2 = PanelY + 48;  // rótulo (inferior)
   int yValue2 = PanelY + 64;  // valor inferior

   int x = PanelX + 8;

   // --- Coluna 1: ATIVO / STATUS ---
   CreateLabel("GP_Ativo_Lbl",  "ATIVO",    x, yLabel,  8,  C.textLabel, "Arial");
   CreateLabel("GP_Ativo_Val",  _Symbol,    x, yValue,  11, C.textValue, "Arial Black");
   CreateLabel("GP_Status_Lbl", "STATUS",   x, yLabel2, 8,  C.textLabel, "Arial");
   CreateLabel("GP_Status_V",   "OPERANDO", x, yValue2, 10, C.textPositive, "Arial Black");
   x += colW;
   DrawSep("GP_Sep1", x - 4, C.separator);

   // --- Coluna 2: SALDO / EQUITY ---
   CreateLabel("GP_Saldo_Lbl",  "SALDO",    x, yLabel,  8,  C.textLabel, "Arial");
   CreateLabel("GP_Saldo_Val",  "R$ 0,00",  x, yValue,  11, C.textValue, "Arial Black");
   CreateLabel("GP_Equity_Lbl", "EQUITY",   x, yLabel2, 8,  C.textLabel, "Arial");
   CreateLabel("GP_Equity_Val", "R$ 0,00",  x, yValue2, 10, C.textPositive, "Arial Black");
   x += colW;
   DrawSep("GP_Sep2", x - 4, C.separator);

   // --- Coluna 3: LUCRO FLUT. / LUCRO HIST. ---
   CreateLabel("GP_LF_Lbl", "LUCRO FLUT.", x, yLabel,  8,  C.textLabel, "Arial");
   CreateLabel("GP_LF_Val", "+ R$ 0,00",   x, yValue,  11, C.textPositive, "Arial Black");
   CreateLabel("GP_LH_Lbl", "LUCRO HIST.", x, yLabel2, 8,  C.textLabel, "Arial");
   CreateLabel("GP_LH_Val", "+ R$ 0,00",   x, yValue2, 10, C.textPositive, "Arial Black");
   x += colW;
   DrawSep("GP_Sep3", x - 4, C.separator);

   // --- Coluna 4: ORDENS / COMPRAS / VENDAS ---
   CreateLabel("GP_Ordens_Lbl", "ORDENS",  x, yLabel,  8,  C.textLabel, "Arial");
   CreateLabel("GP_Ordens_Val", "0",       x, yValue,  13, C.textValue, "Arial Black");
   CreateLabel("GP_Buy_Lbl",    "COMPRAS", x, yLabel2, 8,  C.textBuy, "Arial");
   CreateLabel("GP_Buy_Val",    "0",       x + 55, yLabel2, 8, C.textBuy, "Arial Bold");
   CreateLabel("GP_Sell_Lbl",   "VENDAS",  x, yValue2, 8,  C.textSell, "Arial");
   CreateLabel("GP_Sell_Val",   "0",       x + 55, yValue2, 8, C.textSell, "Arial Bold");
   x += colW;
   DrawSep("GP_Sep4", x - 4, C.separator);

   // --- Coluna 5: DRAWDOWN / SPREAD ---
   CreateLabel("GP_DD_Lbl",  "DRAWDOWN", x, yLabel,  8,  C.textLabel, "Arial");
   CreateLabel("GP_DD_Val",  "0.0%",     x, yValue,  11, C.textWarning, "Arial Black");
   CreateLabel("GP_Spr_Lbl", "SPREAD",   x, yLabel2, 8,  C.textLabel, "Arial");
   CreateLabel("GP_Spr_Val", "0.0 pips", x, yValue2, 10, C.textValue, "Arial Black");
   x += colW;
   DrawSep("GP_Sep5", x - 4, C.separator);

   // === Bloco do botão REINICIAR ESTRATÉGIA ===
   int btnX = PanelX + W - btnW - themeW - gap*2;
   CreateRect("GP_ReinitBG", btnX, PanelY + 8, btnW, H - 16,
              C.btnBg, C.btnBg, 1);
   CreateBtnLabel("GridPanel_ReinitBtn", "REINICIAR\nESTRATÉGIA",
                  btnX, PanelY + 8, btnW, H - 16,
                  C.btnBg, C.btnText);

   // === Seletor de TEMA (menor, ao lado do botão vermelho) ===
   int themeX = PanelX + W - themeW - gap;
   CreateBtnLabel("GridPanel_ThemeBtn",
                  (currentTheme == THEME_DARK) ? "TEMA CLARO" : "TEMA ESCURO",
                  themeX, PanelY + 8, themeW, H - 16,
                  C.btnNeutralBg, C.btnNeutralText);
}

