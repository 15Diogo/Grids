//+------------------------------------------------------------------+
//| ENUM DE TEMAS                                                     |
//+------------------------------------------------------------------+
enum ENUM_THEME
{
   THEME_DARK  = 0,  // Tema Escuro
   THEME_LIGHT = 1   // Tema Claro
};

//--- Parâmetros de entrada
input double   Volume           = 0.01;       // Volume das ordens (0 = micro lote)
input int      PipDistance      = 15;         // Distância em pips entre ordens
input int      TakeProfit       = 15;         // Take Profit em pips
input string   EA_Comment       = "Grid_EA";  // Comentário das ordens
input int      MagicNumber      = 12345;      // Número mágico

//--- Parâmetros do Painel
input bool         ShowPanel        = true;        // Mostrar painel de informações
input ENUM_THEME   Theme            = THEME_DARK;  // Tema (Escuro / Claro)
input bool         ApplyChartColors = true;        // Aplicar cores do tema no gráfico
input double       InitialBalance   = 25000.0;     // Saldo inicial de referência (P&L)

//--- Variáveis globais
double lastOrderPrice      = 0;
double pipValue;
bool   initialOrdersPlaced = true;
ENUM_THEME currentTheme;

// Seções colapsáveis
bool secConta   = true;
bool secPos     = true;
bool secManual  = true;
bool secControl = true;

//-----------------------------------------------------------
// LAYOUT  (ajuste fino — tudo em pixels)
//-----------------------------------------------------------
//  BARRA SUPERIOR: largura total da janela, altura TOP_H
//  PAINEL LATERAL: da esquerda, abaixo da barra, largura SIDE_W
//  VAL_X: coluna fixa onde os valores começam no painel lateral
//         → garante alinhamento uniforme independente do tamanho do label
//-----------------------------------------------------------
#define TOP_H      88    // altura da barra superior (mais compacta e limpa)
#define SIDE_W     320   // largura do painel lateral (aumentado para evitar sobreposição)
#define SIDE_X     0     // x do painel lateral
#define SIDE_Y     TOP_H // painel lateral começa logo abaixo da barra
#define SECTION_H  28    // cabeçalho de seção
#define ROW_H      24    // linha de dados
#define PAD        9     // padding horizontal interno
#define VAL_X      180   // coluna fixa dos valores no painel lateral (alinhamento uniforme)

