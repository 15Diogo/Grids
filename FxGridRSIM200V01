void CriarPainelModerno()
{
   int x = Painel_X;
   int y = Painel_Y;
   int largura = PAINEL_LARGURA;
   int altura  = PAINEL_ALTURA;
   
   // Moldura externa
   CriarObjetoPainel("painel_borda", x-2, y-2, largura+4, altura+4, Cor_Header);
   CriarObjetoPainel("painel_fundo", x, y, largura, altura, Cor_Fundo);
   
   // Cabeçalho
   CriarObjetoPainel("painel_header", x, y, largura, 45, Cor_Header);
   
   // Fundos internos de cada seção (efeito "cartão": borda fina + preenchimento)
   CriarObjetoPainel("fundo_sessao_b", x+7, y+51, largura-14, 100, Cor_Borda);
   CriarObjetoPainel("fundo_sessao", x+8, y+52, largura-16, 98, Cor_Painel_Interno);
   
   CriarObjetoPainel("fundo_mercado_b", x+7, y+158, largura-14, 122, Cor_Borda);
   CriarObjetoPainel("fundo_mercado", x+8, y+159, largura-16, 120, Cor_Painel_Interno);
   
   CriarObjetoPainel("fundo_lote_b", x+7, y+286, largura-14, 60, Cor_Borda);
   CriarObjetoPainel("fundo_lote", x+8, y+287, largura-16, 58, Cor_Painel_Interno);
   
   CriarObjetoPainel("fundo_posicoes_b", x+7, y+352, largura-14, 62, Cor_Borda);
   CriarObjetoPainel("fundo_posicoes", x+8, y+353, largura-16, 60, Cor_Painel_Interno);
   
   // Divisórias entre seções
   CriarObjetoPainel("painel_linha_sessao_fim", x, y+155, largura, 1, Cor_Borda);
   CriarObjetoPainel("painel_linha_mercado_fim", x, y+283, largura, 1, Cor_Borda);
   CriarObjetoPainel("painel_linha_lote_fim", x, y+349, largura, 1, Cor_Borda);
   
   // Títulos das seções (estáticos)
   CriarSecao("sec_sessao", x+15, y+59, "SESSÃO ATUAL");
   CriarSecao("sec_mercado", x+15, y+166, "CONDIÇÕES DE MERCADO");
   CriarSecao("sec_lote", x+15, y+294, "LOTE & PROGRESSÃO");
   CriarSecao("sec_posicoes", x+15, y+360, "POSIÇÕES ABERTAS");
   
   if(Mostrar_Botao_Reset)
   {
      CriarObjetoPainel("painel_linha_botao", x, y+420, largura, 1, Cor_Borda);
      CriarBotao("btn_reset", x+15, y+428, largura-30, 24, "🔄  RESET MANUAL", Cor_Botao, clrWhite);
   }
   
   ChartRedraw();
}

//+------------------------------------------------------------------+
//| Painel Moderno — Conteúdo Dinâmico (atualizado a cada tick)      |
//+------------------------------------------------------------------+
void AtualizarPainelModerno()
{
   int x = Painel_X;
   int y = Painel_Y;
   int largura = PAINEL_LARGURA;
   
   // ---------- Cabeçalho ----------
   CriarTexto("txt_titulo", x+15, y+10, "GRID TRADER PRO", clrWhite, 12, "Arial Black");
   
   string timeframe = EnumToString((ENUM_TIMEFRAMES)Period());
   StringReplace(timeframe, "PERIOD_", "");
   CriarTexto("txt_simbolo", x+15, y+27, _Symbol + "   •   " + timeframe, C'220,235,255', 9, "Courier New");
   
   // ---------- Seção: Sessão Atual ----------
   double capital_atual = AccountInfoDouble(ACCOUNT_EQUITY);
   double resultado_sessao = capital_atual - capital_inicial_sessao;
   double percentual_sessao = (capital_inicial_sessao > 0) ? (resultado_sessao / capital_inicial_sessao) * 100 : 0;
   color cor_resultado = (resultado_sessao >= 0) ? Cor_Positivo : Cor_Negativo;
   string sinal_resultado = (resultado_sessao >= 0) ? "+" : "";
   
   CriarTexto("txt_saldo_inicial_label", x+25, y+80, "Saldo Inicial", Cor_Texto_Sec, 8, "Arial");
   CriarTexto("txt_saldo_inicial_valor", x+largura-135, y+80, "$" + DoubleToString(balance_inicial, 2), Cor_Texto, 9, "Courier New");
   
   CriarTexto("txt_cap_atual_label", x+25, y+97, "Capital Atual", Cor_Texto_Sec, 8, "Arial");
   CriarTexto("txt_cap_atual_valor", x+largura-135, y+97, "$" + DoubleToString(capital_atual, 2), Cor_Texto, 9, "Courier New");
   
   CriarTexto("txt_resultado_label", x+25, y+116, "Resultado da Sessão", Cor_Texto_Sec, 8, "Arial");
   CriarTexto("txt_resultado_valor", x+largura-160, y+114, 
              sinal_resultado + "$" + DoubleToString(MathAbs(resultado_sessao), 2) + "  (" + 
              sinal_resultado + DoubleToString(MathAbs(percentual_sessao), 2) + "%)", 
              cor_resultado, 11, "Arial Black");
              
   CriarTexto("txt_stop_info", x+25, y+136, "Stop sessão: $" + DoubleToString(Stop_Loss_Sessao,0) + " | Resets: " + IntegerToString(contador_resets), Cor_Texto_Sec, 8, "Arial");

   // ---------- Seção: Condições de Mercado ----------
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   
   CriarTexto("txt_ask_label", x+25, y+188, "Ask", Cor_Texto_Sec, 8, "Arial");
   CriarTexto("txt_ask_val", x+60, y+188, DoubleToString(ask, _Digits), Cor_Texto, 9, "Courier New");
   CriarTexto("txt_bid_label", x+190, y+188, "Bid", Cor_Texto_Sec, 8, "Arial");
   CriarTexto("txt_bid_val", x+225, y+188, DoubleToString(bid, _Digits), Cor_Texto, 9, "Courier New");
   
   // --- RSI ---
   color cor_rsi;
   string status_rsi;
   if(rsi_atual >= RSI_Nivel_Sobrecompra)      { cor_rsi = Cor_Negativo; status_rsi = "SOBRECOMPRA"; }
   else if(rsi_atual <= RSI_Nivel_Sobrevenda)  { cor_rsi = Cor_Positivo; status_rsi = "SOBREVENDA";  }
   else                                        { cor_rsi = Cor_Alerta;   status_rsi = "NEUTRO";      }
   
   CriarTexto("txt_rsi_label", x+25, y+207, "RSI (" + IntegerToString(RSI_Periodo) + ")", Cor_Texto_Sec, 8, "Arial");
   CriarTexto("txt_rsi_val", x+95, y+207, DoubleToString(rsi_atual, 2), Cor_Texto, 9, "Courier New");
   CriarTexto("txt_rsi_status", x+150, y+207, "[" + status_rsi + "]" + (Usar_Filtro_RSI ? "" : "  (filtro off)"), cor_rsi, 8, "Arial Black");
   
   // --- MA200 ---
   bool acima_media = (ask > ma_atual);
   color cor_ma = acima_media ? Cor_Positivo : Cor_Negativo;
   string status_ma = acima_media ? "ALTA ▲" : "BAIXA ▼";
   
   CriarTexto("txt_ma_label", x+25, y+225, "MA(" + IntegerToString(MA_Periodo) + ")", Cor_Texto_Sec, 8, "Arial");
   CriarTexto("txt_ma_val", x+95, y+225, DoubleToString(ma_atual, _Digits), Cor_Texto, 9, "Courier New");
   CriarTexto("txt_ma_status", x+215, y+225, "[" + status_ma + "]" + (Usar_Filtro_MA200 ? "" : "  (filtro off)"), cor_ma, 8, "Arial Black");
   
   // --- Bandas da MA200 (MA ± Distancia_Banda_MA pontos) ---
   double point_ = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   double banda_sup = ma_atual + (Distancia_Banda_MA * point_);
   double banda_inf = ma_atual - (Distancia_Banda_MA * point_);
   
   CriarTexto("txt_banda_label", x+25, y+243, "Bandas (±" + IntegerToString(Distancia_Banda_MA) + " pts)", Cor_Texto_Sec, 8, "Arial");
   CriarTexto("txt_banda_sup", x+165, y+243, "Sup " + DoubleToString(banda_sup, _Digits), Cor_Banda_Superior, 8, "Courier New");
   CriarTexto("txt_banda_inf", x+260, y+243, "Inf " + DoubleToString(banda_inf, _Digits), Cor_Banda_Inferior, 8, "Courier New");
   
   // --- Pílula de Status de Entradas (combina RSI + MA200) ---
   bool permitido = RSIPermiteCompra() && MAPermiteCompra();
   string motivo = "";
   if(!permitido)
   {
      if(!RSIPermiteCompra() && !MAPermiteCompra()) motivo = " (RSI + MA200)";
      else if(!RSIPermiteCompra())                  motivo = " (RSI)";
      else                                          motivo = " (MA200)";
   }
   color cor_pill = permitido ? Cor_Positivo : Cor_Negativo;
   string texto_pill = permitido ? "✅  NOVAS ENTRADAS LIBERADAS" : "⛔  ENTRADAS BLOQUEADAS" + motivo;
   
   CriarObjetoPainel("painel_status_bg", x+15, y+261, largura-30, 20, cor_pill);
   CriarTexto("txt_status_val", x+15, y+265, texto_pill, clrWhite, 9, "Arial Black", CORNER_LEFT_UPPER);
   // Centraliza aproximadamente o texto na pílula
   ObjectSetInteger(0, "txt_status_val", OBJPROP_ANCHOR, ANCHOR_LEFT);
   ObjectSetInteger(0, "txt_status_val", OBJPROP_XDISTANCE, x + (largura/2) - (StringLen(texto_pill)*3));
   
   // ---------- Seção: Lote & Progressão ----------
   int compras_ativas = ContarOrdens(POSITION_TYPE_BUY);
   double lote_atual = CalcularLoteAtual();
   int proximo_nivel_em = Usar_Lote_Progressivo && Ordens_Para_Incrementar > 0
                           ? (Ordens_Para_Incrementar - (compras_ativas % Ordens_Para_Incrementar))
                           : 0;
   
   CriarTexto("txt_lote_label", x+25, y+316, "Lote Atual de Compra", Cor_Texto_Sec, 8, "Arial");
   CriarTexto("txt_lote_val", x+largura-100, y+314, DoubleToString(lote_atual, 2) + " lotes", Cor_Header, 11, "Arial Black");
   
   string txt_progressao = Usar_Lote_Progressivo 
                            ? "Compras ativas: " + IntegerToString(compras_ativas) + "   |   Próx. incremento em " + IntegerToString(proximo_nivel_em)
                            : "Lote progressivo desativado";
   CriarTexto("txt_progressao_val", x+25, y+333, txt_progressao, Cor_Texto_Sec, 8, "Courier New");
   
   // ---------- Seção: Posições Abertas ----------
   double lucro_posicoes = CalcularLucroEA();
   color cor_lucro = (lucro_posicoes >= 0) ? Cor_Positivo : Cor_Negativo;
   string sinal_lucro = (lucro_posicoes >= 0) ? "+" : "";
   
   CriarTexto("txt_compras_label", x+25, y+382, "▲ Posições de Compra", Cor_Positivo, 9, "Courier New");
   CriarTexto("txt_compras_valor", x+largura-60, y+380, IntegerToString(compras_ativas), Cor_Texto, 12, "Arial Black");
   
   CriarTexto("txt_lucro_label", x+25, y+400, "Lucro Flutuante", Cor_Texto, 9, "Arial");
   CriarTexto("txt_lucro_valor", x+largura-135, y+398, sinal_lucro + "$" + DoubleToString(MathAbs(lucro_posicoes), 2), cor_lucro, 11, "Arial Black");
   
   ChartRedraw(0);
}

double CalcularLucroEA()
{
   double lucro = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != Magic_Number) continue;
      lucro += PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
   }
   return lucro;
}

int ContarOrdens(ENUM_POSITION_TYPE tipo)
{
   int count = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != Magic_Number) continue;
      if((ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE) == tipo) count++;
   }
   return count;
}

void CriarObjetoPainel(string nome, int x, int y, int largura, int altura, color cor, int corner = CORNER_LEFT_UPPER)
{
   if(ObjectFind(0, nome) >= 0) ObjectDelete(0, nome);
   ObjectCreate(0, nome, OBJ_RECTANGLE_LABEL, 0, 0, 0);
   ObjectSetInteger(0, nome, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, nome, OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, nome, OBJPROP_XSIZE, largura);
   ObjectSetInteger(0, nome, OBJPROP_YSIZE, altura);
   ObjectSetInteger(0, nome, OBJPROP_BGCOLOR, cor);
   ObjectSetInteger(0, nome, OBJPROP_BORDER_TYPE, BORDER_FLAT);
   ObjectSetInteger(0, nome, OBJPROP_CORNER, corner);
   ObjectSetInteger(0, nome, OBJPROP_COLOR, cor);
   ObjectSetInteger(0, nome, OBJPROP_BACK, false);
   ObjectSetInteger(0, nome, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, nome, OBJPROP_HIDDEN, true);
}

void CriarTexto(string nome, int x, int y, string texto, color cor, int tamanho, string fonte = "Arial", int corner = CORNER_LEFT_UPPER)
{
   if(ObjectFind(0, nome) >= 0) ObjectDelete(0, nome);
   ObjectCreate(0, nome, OBJ_LABEL, 0, 0, 0);
   ObjectSetInteger(0, nome, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, nome, OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, nome, OBJPROP_CORNER, corner);
   ObjectSetInteger(0, nome, OBJPROP_COLOR, cor);
   ObjectSetString(0, nome, OBJPROP_FONT, fonte);
   ObjectSetInteger(0, nome, OBJPROP_FONTSIZE, tamanho);
   ObjectSetString(0, nome, OBJPROP_TEXT, texto);
   ObjectSetInteger(0, nome, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, nome, OBJPROP_HIDDEN, true);
}

void CriarBotao(string nome, int x, int y, int largura, int altura, string texto, color cor_fundo, color cor_texto)
{
   if(ObjectFind(0, nome) >= 0) ObjectDelete(0, nome);
   ObjectCreate(0, nome, OBJ_BUTTON, 0, 0, 0);
   ObjectSetInteger(0, nome, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, nome, OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, nome, OBJPROP_XSIZE, largura);
   ObjectSetInteger(0, nome, OBJPROP_YSIZE, altura);
   ObjectSetInteger(0, nome, OBJPROP_CORNER, CORNER_LEFT_UPPER);
   ObjectSetInteger(0, nome, OBJPROP_BGCOLOR, cor_fundo);
   ObjectSetInteger(0, nome, OBJPROP_COLOR, cor_texto);
   
   ObjectSetString(0, nome, OBJPROP_TEXT, texto);
   ObjectSetString(0, nome, OBJPROP_FONT, "Arial Black");
   ObjectSetInteger(0, nome, OBJPROP_FONTSIZE, 9);
   ObjectSetInteger(0, nome, OBJPROP_STATE, false);
   ObjectSetInteger(0, nome, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, nome, OBJPROP_HIDDEN, true);
}

