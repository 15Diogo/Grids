//+------------------------------------------------------------------+
//| Função de Inicialização                                          |
//+------------------------------------------------------------------+
int OnInit()
{
   trade.SetExpertMagicNumber(Magic_Number);
   trade.SetDeviationInPoints(10);
   
   ENUM_SYMBOL_TRADE_EXECUTION exe_mode = (ENUM_SYMBOL_TRADE_EXECUTION)SymbolInfoInteger(_Symbol, SYMBOL_TRADE_EXEMODE);
   
   if(exe_mode == SYMBOL_TRADE_EXECUTION_EXCHANGE || exe_mode == SYMBOL_TRADE_EXECUTION_INSTANT)
      trade.SetTypeFilling(ORDER_FILLING_RETURN);
   else
      trade.SetTypeFilling(ORDER_FILLING_FOK);
   
   balance_inicial = AccountInfoDouble(ACCOUNT_BALANCE);
   capital_inicial_sessao = AccountInfoDouble(ACCOUNT_EQUITY);
   hora_inicio_sessao = TimeCurrent();
   
   // Cria o handle do RSI
   rsi_handle = iRSI(_Symbol, RSI_Timeframe, RSI_Periodo, RSI_Preco);
   if(rsi_handle == INVALID_HANDLE)
   {
      Print("❌ ERRO: Não foi possível criar o indicador RSI. Código: ", GetLastError());
      return(INIT_FAILED);
   }
   
   // Cria o handle da Média Móvel
   ma_handle = iMA(_Symbol, MA_Timeframe, MA_Periodo, 0, MA_Metodo, MA_Preco);
   if(ma_handle == INVALID_HANDLE)
   {
      Print("❌ ERRO: Não foi possível criar o indicador de Média Móvel. Código: ", GetLastError());
      return(INIT_FAILED);
   }
   
   PAINEL_ALTURA = Mostrar_Botao_Reset ? 464 : 420;
   
   // Plota os indicadores diretamente no gráfico (visual), além dos valores no painel
   if(!ChartIndicatorAdd(0, 0, ma_handle))
      Print("⚠️ Aviso: não foi possível plotar a MA200 no gráfico. Código: ", GetLastError());
   
   if(!ChartIndicatorAdd(0, 1, rsi_handle))
      Print("⚠️ Aviso: não foi possível plotar o RSI na subjanela. Código: ", GetLastError());
   
   CriarPainelModerno();
   VerificarOrdensExistentes();
   AtualizarRSI();
   AtualizarMA();
   DesenharBandasMA();
   
   Print("═══════════════════════════════════════");
   Print("   Grid Trader Compras v3.3 (Auto-Reset + Lote Progressivo + RSI Sobrevenda + MA200 + Bandas ±" + IntegerToString(Distancia_Banda_MA) + "pts + Painel com cartões) Ativado");
   Print("═══════════════════════════════════════");
   
   return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
//| Função de Desinicialização                                       |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   if(rsi_handle != INVALID_HANDLE) IndicatorRelease(rsi_handle);
   if(ma_handle  != INVALID_HANDLE) IndicatorRelease(ma_handle);
      
   DeletarTodosObjetos();
}

//+------------------------------------------------------------------+
//| Função Principal (Tick)                                          |
//+------------------------------------------------------------------+
void OnTick()
{
   AtualizarRSI();
   AtualizarMA();
   DesenharBandasMA();
   AtualizarPainelModerno();

   // Proteção baseada no resultado da sessão.
   // Se atingir o limite, fecha as posições e reinicia a sessão.
   if(VerificarStopSessao()) return;

   ExecutarEstrategiaCompra();
}

//+------------------------------------------------------------------+
//| Atualiza o valor atual do RSI                                    |
//+------------------------------------------------------------------+
bool AtualizarRSI()
{
   if(rsi_handle == INVALID_HANDLE) return false;
   
   double buffer[];
   ArraySetAsSeries(buffer, true);
   
   if(CopyBuffer(rsi_handle, 0, 0, 2, buffer) < 2)
      return false;
   
   rsi_atual = buffer[0];
   return true;
}

//+------------------------------------------------------------------+
//| Atualiza o valor atual da Média Móvel                            |
//+------------------------------------------------------------------+
bool AtualizarMA()
{
   if(ma_handle == INVALID_HANDLE) return false;
   
   double buffer[];
   ArraySetAsSeries(buffer, true);
   
   if(CopyBuffer(ma_handle, 0, 0, 2, buffer) < 2)
      return false;
   
   ma_atual = buffer[0];
   return true;
}

//+------------------------------------------------------------------+
//| Desenha no gráfico as bandas acima/abaixo da MA200                |
//| (linhas horizontais em MA + Distancia_Banda_MA e MA - Distancia)  |
//+------------------------------------------------------------------+
void DesenharBandasMA()
{
   if(ma_handle == INVALID_HANDLE) return;
   
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   double banda_superior = ma_atual + (Distancia_Banda_MA * point);
   double banda_inferior = ma_atual - (Distancia_Banda_MA * point);
   
   CriarLinhaHorizontal("linha_banda_superior", banda_superior, Cor_Banda_Superior);
   CriarLinhaHorizontal("linha_banda_inferior", banda_inferior, Cor_Banda_Inferior);
}

//+------------------------------------------------------------------+
//| Cria/atualiza uma linha horizontal no gráfico principal           |
//+------------------------------------------------------------------+
void CriarLinhaHorizontal(string nome, double preco, color cor)
{
   if(ObjectFind(0, nome) < 0)
   {
      ObjectCreate(0, nome, OBJ_HLINE, 0, 0, preco);
      ObjectSetInteger(0, nome, OBJPROP_STYLE, STYLE_DOT);
      ObjectSetInteger(0, nome, OBJPROP_WIDTH, 1);
      ObjectSetInteger(0, nome, OBJPROP_BACK, true);
      ObjectSetInteger(0, nome, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, nome, OBJPROP_HIDDEN, true);
   }
   else
   {
      ObjectSetDouble(0, nome, OBJPROP_PRICE, preco);
   }
   ObjectSetInteger(0, nome, OBJPROP_COLOR, cor);
   ObjectSetString(0, nome, OBJPROP_TOOLTIP, "Banda MA(" + IntegerToString(MA_Periodo) + ") " + 
                    (preco > ma_atual ? "+" : "-") + IntegerToString(Distancia_Banda_MA) + " pts: " + DoubleToString(preco, _Digits));
}

//+------------------------------------------------------------------+
//| Define se o filtro de RSI permite abrir uma nova compra          |
//| Regra: só permite compra quando o RSI está em SOBREVENDA,        |
//| ou seja, abaixo do nível definido em RSI_Nivel_Sobrevenda (30)   |
//+------------------------------------------------------------------+
bool RSIPermiteCompra()
{
   if(!Usar_Filtro_RSI) return true;
   return (rsi_atual < RSI_Nivel_Sobrevenda);
}

//+------------------------------------------------------------------+
//| Define se o filtro de Média Móvel permite abrir uma nova compra  |
//| Regra: só compra se o preço estiver ACIMA da MA (tendência alta) |
//+------------------------------------------------------------------+
bool MAPermiteCompra()
{
   if(!Usar_Filtro_MA200) return true;
   double preco_atual = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   return (preco_atual > ma_atual);
}



//+------------------------------------------------------------------+
//| Stop baseado no resultado acumulado da sessão                     |
//| A referência é o equity registrado no início/reset da sessão.     |
//+------------------------------------------------------------------+
bool VerificarStopSessao()
{
   if(Stop_Loss_Sessao <= 0) return false;

   double equity_atual = AccountInfoDouble(ACCOUNT_EQUITY);
   double resultado_sessao = equity_atual - capital_inicial_sessao;

   if(resultado_sessao <= -MathAbs(Stop_Loss_Sessao))
   {
      Print("STOP DA SESSÃO ATINGIDO. Resultado: $", DoubleToString(resultado_sessao, 2));
      contador_resets++;
      ResetarEstrategia();
      return true;
   }

   return false;
}

