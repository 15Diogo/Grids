   // Fundo principal limpo
   CriarObjetoPainel("painel_fundo", x, y, largura, altura, Cor_Fundo);
   CriarObjetoPainel("painel_header", x, y, largura, 42, Cor_Header);
   
   // Blocos / Cartões Flutuantes (Sem linhas de grade, apenas blocos sólidos)
   CriarObjetoPainel("card_conta", x+10, y+50, largura-20, 105, Cor_Card);
   CriarObjetoPainel("card_mercado", x+10, y+163, largura-20, 110, Cor_Card);
   CriarObjetoPainel("card_ops", x+10, y+281, largura-20, 95, Cor_Card);
   
   // Títulos das seções limpos
   CriarSecao("sec_conta", x+10, y+58, "SESSÃO & CONTA");
   CriarSecao("sec_mercado", x+10, y+171, "MERCADO & INDICADOR");
   CriarSecao("sec_ops", x+10, y+289, "OPERACIONAL & GRID");
   
   if(Mostrar_Botao_Reset) {
      CriarBotao("btn_reset", x+10, y+384, largura-20, 24, "🔄  RESET MANUAL", Cor_Botao, clrWhite);
   }
   ChartRedraw();
}

void AtualizarPainelModerno()
{
   int x = Painel_X;
   int y = Painel_Y;
   int largura = PAINEL_LARGURA;
   
   // Header
   CriarTexto("txt_titulo", x+15, y+8, "GRID TRADER PRO", clrWhite, 11, "Arial Black");
   string timeframe = EnumToString((ENUM_TIMEFRAMES)Period());
   StringReplace(timeframe, "PERIOD_", "");
   CriarTexto("txt_simbolo", x+15, y+24, _Symbol + "   •   " + timeframe, C'200,220,240', 8, "Courier New");
   
   // Cartão Conta
   double saldo_atual = AccountInfoDouble(ACCOUNT_BALANCE);
   double capital_atual = AccountInfoDouble(ACCOUNT_EQUITY); 
   double resultado_sessao = capital_atual - capital_inicial_sessao;
   color cor_resultado = (resultado_sessao >= 0) ? Cor_Positivo : Cor_Negativo;
   string sinal = (resultado_sessao >= 0) ? "+" : "";
   
   CriarTexto("txt_saldo_ini", x+20, y+78, "Saldo Inicial: $" + DoubleToString(balance_inicial, 2), Cor_Texto_Sec, 8, "Arial");
   CriarTexto("txt_saldo_atu", x+20, y+94, "Saldo Líquido: $" + DoubleToString(saldo_atual, 2), Cor_Texto_Sec, 8, "Arial");
   CriarTexto("txt_patrimonio", x+20, y+110, "Patrimônio:", Cor_Texto, 9, "Arial");
   CriarTexto("txt_patrimonio_val", x+95, y+109, "$" + DoubleToString(capital_atual, 2), clrWhite, 10, "Arial Black");
   
   CriarTexto("txt_resultado", x+20, y+129, "Resultado:", Cor_Texto, 9, "Arial");
   CriarTexto("txt_resultado_val", x+95, y+128, sinal + "$" + DoubleToString(MathAbs(resultado_sessao), 2), cor_resultado, 10, "Arial Black");
   
   // Cartão Mercado & RSI
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   
   CriarTexto("txt_ask_bid", x+20, y+191, "Ask: " + DoubleToString(ask, _Digits) + "   |   Bid: " + DoubleToString(bid, _Digits), Cor_Texto_Sec, 8, "Courier New");
   
   color cor_rsi = (rsi_atual <= RSI_Nivel_Sobrevenda) ? Cor_Positivo : ((rsi_atual >= RSI_Nivel_Sobrecompra) ? Cor_Negativo : Cor_Alerta);
   CriarTexto("txt_rsi_lbl", x+20, y+211, "RSI(14):", Cor_Texto, 9, "Arial");
   CriarTexto("txt_rsi_val", x+75, y+210, DoubleToString(rsi_atual, 1), cor_rsi, 10, "Arial Black");

   // Pílula de Status Minimalista
   string txt_pill = "";
   color cor_pill;

   if(!grid_ja_ativado) {
      bool permitido = RSIPermiteCompra() && MAPermiteCompra();
      if(permitido) {
         txt_pill = "● GATILHO INICIAL DISPONÍVEL";
         cor_pill = Cor_Positivo;
      } else {
         txt_pill = "● AGUARDANDO RSI(14) SOBREVENDA";
         cor_pill = Cor_Alerta;
      }
   } else {
      txt_pill = "● GRID PERPÉTUO ATIVO";
      cor_pill = Cor_Header;
   }
   
   CriarObjetoPainel("pill_status", x+20, y+238, largura-40, 20, Cor_Fundo);
   CriarTexto("txt_status_val", x+30, y+242, txt_pill, cor_pill, 8, "Arial Black");

   // Cartão Operacional
   int compras_ativas = ContarOrdens(POSITION_TYPE_BUY);
   double lote_atual = CalcularLoteAtual();
   double lucro_posicoes = CalcularLucroEA();
   
   CriarTexto("txt_compras_lbl", x+20, y+307, "Ordens Compradas:", Cor_Texto, 9, "Arial");
   CriarTexto("txt_compras_val", x+135, y+306, IntegerToString(compras_ativas), clrWhite, 10, "Arial Black");

   CriarTexto("txt_lote_lbl", x+20, y+326, "Lote Atual:", Cor_Texto, 9, "Arial");
   CriarTexto("txt_lote_val", x+135, y+325, DoubleToString(lote_atual, 2), Cor_Header, 10, "Arial Black");

   color cor_lucro = (lucro_posicoes >= 0) ? Cor_Positivo : Cor_Negativo;
   CriarTexto("txt_lucro_lbl", x+20, y+345, "Lucro Flutuante:", Cor_Texto, 9, "Arial");
   CriarTexto("txt_lucro_val", x+135, y+344, (lucro_posicoes>=0?"+":"") + "$" + DoubleToString(MathAbs(lucro_posicoes), 2), cor_lucro, 10, "Arial Black");

   ChartRedraw(0);
}

double CalcularLucroEA()
{
   double lucro = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0) continue;
      if(PositionGetString(POSITION_SYMBOL) == _Symbol && PositionGetInteger(POSITION_MAGIC) == Magic_Number)
         lucro += PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
   }
   return lucro;
}

int ContarOrdens(ENUM_POSITION_TYPE tipo)
{
   int count = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--) {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0) continue;
      if(PositionGetString(POSITION_SYMBOL) == _Symbol && PositionGetInteger(POSITION_MAGIC) == Magic_Number)
         if((ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE) == tipo) count++;
   }
   return count;
}

void CriarObjetoPainel(string nome, int x, int y, int largura, int altura, color cor, int corner = CORNER_LEFT_UPPER)
{
   if(ObjectFind(0, nome) >= 0) ObjectDelete(0, nome);
   ObjectCreate(0, nome, OBJ_RECTANGLE_LABEL, 0, 0, 0);
   ObjectSetInteger(0, nome, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, nome, OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, nome, OBJPROP_XSIZE, largura);
   ObjectSetInteger(0, nome, OBJPROP_YSIZE, altura);
   ObjectSetInteger(0, nome, OBJPROP_BGCOLOR, cor);
   ObjectSetInteger(0, nome, OBJPROP_BORDER_TYPE, BORDER_FLAT);
   ObjectSetInteger(0, nome, OBJPROP_CORNER, corner);
   ObjectSetInteger(0, nome, OBJPROP_COLOR, cor);
   ObjectSetInteger(0, nome, OBJPROP_BACK, false);
   ObjectSetInteger(0, nome, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, nome, OBJPROP_HIDDEN, true);
}

void CriarTexto(string nome, int x, int y, string texto, color cor, int tamanho, string fonte = "Arial", int corner = CORNER_LEFT_UPPER)
{
   if(ObjectFind(0, nome) >= 0) ObjectDelete(0, nome);
   ObjectCreate(0, nome, OBJ_LABEL, 0, 0, 0);
