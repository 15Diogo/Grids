void OnChartEvent(const int id, const long &lparam, const double &dparam, const string &sparam)
{
   if(id == CHARTEVENT_OBJECT_CLICK)
   {
      if(sparam == "btn_reset")
      {
         int resposta = MessageBox(
            "Deseja RESETAR MANUALMENTE a estratégia?",
            "Confirmar Reset Manual",
            MB_YESNO | MB_ICONWARNING
         );
         
         if(resposta == IDYES)
         {
            ResetarEstrategia();
         }
         
         ObjectSetInteger(0, "btn_reset", OBJPROP_STATE, false);
         ChartRedraw();
      }
   }
}

//+------------------------------------------------------------------+
//| Estratégia de Compra (Retoma compras ao voltar para a zona)      |
//+------------------------------------------------------------------+
void ExecutarEstrategiaCompra()
{
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   
   // Bloqueio enquanto as vendas estiverem abertas e o preço estiver baixo
   if(ContarOrdens(POSITION_TYPE_SELL) > 0)
   {
      if(!primeira_venda_aberta || ask <= preco_primeira_venda)
         return; 
   }

   // Define qual lote usar caso alcance uma nova zona
   double lote_atual = primeira_venda_aberta ? Lote_Compra_Retorno : Lote_Compra;

   if(!primeira_compra_aberta)
   {
      if(AbrirOrdemCompra(ask, lote_atual))
      {
         preco_primeira_compra = ask;
         primeira_compra_aberta = true;
      }
      return;
   }
   
   int count_in_level = 0;
   double menor_distancia = 999999;
   double tolerancia = Distancia_Grid_Compra * 0.2; // Tolerância de 20% para engatilhar no "mesmo nível"
   
   // Mapeamento minucioso dos preços próximos ao atual
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != Magic_Number) continue;
      
      ENUM_POSITION_TYPE tipo = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
      if(tipo != POSITION_TYPE_BUY) continue;
      
      double preco_ordem = PositionGetDouble(POSITION_PRICE_OPEN);
      double distancia = MathAbs((ask - preco_ordem) / point);
      
      if(distancia < menor_distancia)
         menor_distancia = distancia;
         
      if(distancia <= tolerancia)
      {
         count_in_level++; // Conta número de ordens estacionadas no nível atual
      }
   }
   
   // LÓGICA DE RETORNO: Se a venda 1 já ocorreu e cruzamos pelo mesmo nível exato de uma velha ordem
   if(primeira_venda_aberta && menor_distancia <= tolerancia)
   {
      // Se houver apenas 1 ordem (a original), abrimos a 2ª ordem agora
      // Se houver 2 ou mais, ignora. Não cria pilhas indesejadas.
      if(count_in_level == 1) 
      {
         AbrirOrdemCompra(ask, Lote_Compra_Retorno);
         return;
      }
      else
      {
         return; // Proteção antimultioperação na volta
      }
   }
   
   // Prevenção de distância "nova". Bloqueia se o pulo na queda não cobrir os pontos do grid.
   if(menor_distancia < Distancia_Grid_Compra)
      return;
   
   // Fora do modo cruzamento antigo em queda, ou expansão de grid abaixo
   AbrirOrdemCompra(ask, lote_atual);
}

//+------------------------------------------------------------------+
//| Estratégia de Venda (Abre SOMENTE SE o preço CAIR)               |
//+------------------------------------------------------------------+
void ExecutarEstrategiaVenda()
{
   int vendas_abertas = ContarOrdens(POSITION_TYPE_SELL);
   if(vendas_abertas >= Max_Vendas)
      return;
   
   if(!primeira_compra_aberta)
      return;
   
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   
   if(!primeira_venda_aberta)
   {
      double queda_da_compra = (preco_primeira_compra - bid) / point;
      
      if(queda_da_compra >= Distancia_Grid_Venda)
      {
         if(AbrirOrdemVenda(bid))
         {
            preco_primeira_venda = bid;
            primeira_venda_aberta = true;
         }
      }
      return;
   }
   
   if(ExisteVendaProxima(bid, Distancia_Grid_Venda))
      return;
   
   double menor_preco_venda = 999999;
   bool tem_venda = false;
   
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != Magic_Number) continue;
      
      ENUM_POSITION_TYPE tipo = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
      if(tipo != POSITION_TYPE_SELL) continue;
      
      double preco_ordem = PositionGetDouble(POSITION_PRICE_OPEN);
      if(preco_ordem < menor_preco_venda)
      {
         menor_preco_venda = preco_ordem;
         tem_venda = true;
      }
   }
   
   if(tem_venda)
   {
      double queda_limite = (menor_preco_venda - bid) / point;
      
      if(queda_limite >= Distancia_Grid_Venda)
      {
         AbrirOrdemVenda(bid);
      }
   }
}

//+------------------------------------------------------------------+
//| Funções Auxiliares                                               |
//+------------------------------------------------------------------+
bool ExisteCompraProxima(double preco, int distancia_minima)
{
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != Magic_Number) continue;
      ENUM_POSITION_TYPE tipo = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
      if(tipo != POSITION_TYPE_BUY) continue;
      
      double preco_ordem = PositionGetDouble(POSITION_PRICE_OPEN);
      double distancia = MathAbs((preco - preco_ordem) / point);
      if(distancia < distancia_minima * 0.5) return true;
   }
   return false;
}

bool ExisteVendaProxima(double preco, int distancia_minima)
{
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != Magic_Number) continue;
      ENUM_POSITION_TYPE tipo = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
      if(tipo != POSITION_TYPE_SELL) continue;
      
      double preco_ordem = PositionGetDouble(POSITION_PRICE_OPEN);
      double distancia = MathAbs((preco - preco_ordem) / point);
      if(distancia < distancia_minima * 0.5) return true;
   }
   return false;
}

bool AbrirOrdemCompra(double preco, double volume = 0)
{
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   double tp = preco + (Take_Profit_Compra * point);
   tp = NormalizeDouble(tp, (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS));
   double lote_usar = (volume > 0) ? volume : Lote_Compra; 
   return trade.Buy(lote_usar, _Symbol, 0, 0, tp, "Grid Buy");
}

bool AbrirOrdemVenda(double preco)
{
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   double tp = preco - (Take_Profit_Venda * point);
   tp = NormalizeDouble(tp, (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS));
   return trade.Sell(Lote_Venda, _Symbol, 0, 0, tp, "Grid Sell");
}

void VerificarOrdensExistentes()
{
   bool tem_compra = false;
   bool tem_venda = false;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != Magic_Number) continue;
      ENUM_POSITION_TYPE tipo = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
      double preco_abertura = PositionGetDouble(POSITION_PRICE_OPEN);
      if(tipo == POSITION_TYPE_BUY)
      {
         tem_compra = true;
         if(preco_primeira_compra == 0 || preco_abertura > preco_primeira_compra)
            preco_primeira_compra = preco_abertura;
      }
      else if(tipo == POSITION_TYPE_SELL)
      {
         tem_venda = true;
         if(preco_primeira_venda == 0 || preco_abertura > preco_primeira_venda)
            preco_primeira_venda = preco_abertura;
      }
   }
   if(tem_compra) primeira_compra_aberta = true;
   if(tem_venda) primeira_venda_aberta = true;
}

void FecharTodasPosicoes()
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != Magic_Number) continue;
      trade.PositionClose(ticket);
   }
}

//+------------------------------------------------------------------+
//| Reset da Estratégia                                              |
//+------------------------------------------------------------------+
void ResetarEstrategia()
{
   FecharTodasPosicoes();
   
   preco_primeira_compra = 0;
   preco_primeira_venda = 0;
   primeira_compra_aberta = false;
   primeira_venda_aberta = false;
   
   balance_inicial = AccountInfoDouble(ACCOUNT_BALANCE);
   capital_inicial_sessao = AccountInfoDouble(ACCOUNT_EQUITY);
   hora_inicio_sessao = TimeCurrent();
   
   AtualizarPainelModerno();
}

//+------------------------------------------------------------------+
//| Cálculo e Helpers                                                |
//+------------------------------------------------------------------+
double CalcularLucroEA()
{
   double lucro = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != Magic_Number) continue;
      lucro += PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
   }
   return lucro;
}

// Preço médio ponderado por volume das posições abertas de um lado (compra ou venda).
// Retorna 0 caso não haja posições desse tipo (usado apenas para exibição no painel).
double CalcularPrecoMedio(ENUM_POSITION_TYPE tipo)
{
   double soma_preco_volume = 0;
   double soma_volume = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != Magic_Number) continue;
      if((ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE) != tipo) continue;
      
      double vol = PositionGetDouble(POSITION_VOLUME);
      double preco = PositionGetDouble(POSITION_PRICE_OPEN);
      soma_preco_volume += preco * vol;
      soma_volume += vol;
   }
   if(soma_volume <= 0) return 0;
   return soma_preco_volume / soma_volume;
}

int ContarOrdens(ENUM_POSITION_TYPE tipo)
{
   int count = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket <= 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != Magic_Number) continue;
      if((ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE) == tipo) count++;
   }
   return count;
}

string FormatarTempo(int segundos)
{
   if(segundos < 0) segundos = 0;
   int horas = segundos / 3600;
   int minutos = (segundos % 3600) / 60;
   int segs = segundos % 60;
   return StringFormat("%02dh %02dm %02ds", horas, minutos, segs);
}

