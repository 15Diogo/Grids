//+------------------------------------------------------------------+
//| Painel Premium Institucional (HUD) - Barra Horizontal no Topo    |
//| 8 blocos lado a lado (Marca | Sessão | Compra | Venda | Operação |
//| Mercado | Preço Médio | Flutuante), cada um com sua própria      |
//| grade vertical de linhas fixas (nenhum texto divide posição).    |
//+------------------------------------------------------------------+
void CriarPainelModerno()
{
   int x = Painel_X;
   int y = Painel_Y;
   int w = Largura_Painel;
   int h = Altura_Painel;
   int pad = 18;
   int col_w = 135;
   int brand_w = 185;
   int flut_w = 185;
   int gutter = 22; // espaço "de ar" entre um bloco e outro, com o divisor centralizado nele

   int x_brand = x + pad;
   int x_col1  = x_brand + brand_w + gutter;   // Sessão
   int x_col2  = x_col1  + col_w   + gutter;   // Grid Compra
   int x_col3  = x_col2  + col_w   + gutter;   // Grid Venda
   int x_col4  = x_col3  + col_w   + gutter;   // Operação (tempo/ordens)
   int x_col5  = x_col4  + col_w   + gutter;   // Mercado (spread/margem)
   int x_col6  = x_col5  + col_w   + gutter;   // Preço Médio
   int x_flut  = x_col6  + col_w   + gutter;   // Flutuante

   // Fundo e sombra
   CriarObjetoPainel("p_shadow", x-2, y-2, w+4, h+4, Cor_Borda);
   CriarObjetoPainel("p_bg", x, y, w, h, Cor_Fundo);

   // Barra dourada superior (identidade visual, ao longo de toda a largura)
   CriarObjetoPainel("p_top", x, y, w, 3, Cor_Header);

   // Cartão de destaque atrás do bloco Flutuante, com respiro em todos os lados
   CriarObjetoPainel("p_card_flut", x_flut - (gutter/2), y + 10, flut_w + (gutter/2) + 6, h - 20, Cor_Cartao);

   // Divisórias verticais centralizadas no meio de cada "gutter"
   int div_y = y + 14;
   int div_h = h - 28;
   CriarObjetoPainel("p_div_0", x_col1 - (gutter/2), div_y, 1, div_h, Cor_Borda);
   CriarObjetoPainel("p_div_1", x_col2 - (gutter/2), div_y, 1, div_h, Cor_Borda);
   CriarObjetoPainel("p_div_2", x_col3 - (gutter/2), div_y, 1, div_h, Cor_Borda);
   CriarObjetoPainel("p_div_3", x_col4 - (gutter/2), div_y, 1, div_h, Cor_Borda);
   CriarObjetoPainel("p_div_4", x_col5 - (gutter/2), div_y, 1, div_h, Cor_Borda);
   CriarObjetoPainel("p_div_5", x_col6 - (gutter/2), div_y, 1, div_h, Cor_Borda);
   CriarObjetoPainel("p_div_6", x_flut - (gutter/2), div_y, 1, div_h, Cor_Borda);

   if(Mostrar_Botao_Reset)
   {
      CriarBotao("btn_reset", x_flut + 12, y + 12, 74, 24, "RESET", Cor_Botao, Cor_Header);
   }

   ChartRedraw();
}

//+------------------------------------------------------------------+
//| Atualização do Painel - grade uniforme: cada bloco usa as linhas |
//| y+16 / y+36 / y+58 (e y+80 apenas no bloco Sessão), sem que dois |
//| textos jamais dividam a mesma posição.                           |
//+------------------------------------------------------------------+
void AtualizarPainelModerno()
{
   int x = Painel_X;
   int y = Painel_Y;
   int pad = 18;
   int col_w = 135;
   int brand_w = 185;
   int gutter = 22;

   int x_brand = x + pad;
   int x_col1  = x_brand + brand_w + gutter;
   int x_col2  = x_col1  + col_w   + gutter;
   int x_col3  = x_col2  + col_w   + gutter;
   int x_col4  = x_col3  + col_w   + gutter;
   int x_col5  = x_col4  + col_w   + gutter;
   int x_col6  = x_col5  + col_w   + gutter;
   int x_flut  = x_col6  + col_w   + gutter;

   int L1 = y + 20;  // linha de rótulo
   int L2 = y + 46;  // linha de valor primário
   int L3 = y + 72;  // linha de valor secundário
   int L4 = y + 98;  // linha extra (somente bloco Sessão)

   // --- BLOCO MARCA ---
   CriarTexto("t_titulo", x_brand, L1, "GRID HÍBRIDO", Cor_Texto, 11, "Arial Black");
   CriarTexto("t_ver", x_brand, L2, "v2.3 • Premium HUD", Cor_Header, 8, "Trebuchet MS");
   string tf = EnumToString((ENUM_TIMEFRAMES)Period()); StringReplace(tf, "PERIOD_", "");
   CriarTexto("t_sym", x_brand, L3, _Symbol + "  •  " + tf, Cor_Texto_Sec, 9, "Trebuchet MS");

   // --- BLOCO SESSÃO (Capital / Resultado / Risco) ---
   double cap_atual = AccountInfoDouble(ACCOUNT_EQUITY);
   double res_sessao = cap_atual - capital_inicial_sessao;
   double pct_sessao = (capital_inicial_sessao > 0) ? (res_sessao / capital_inicial_sessao) * 100 : 0;
   color c_res = (res_sessao >= 0) ? Cor_Positivo : Cor_Negativo;
   string s_res = (res_sessao >= 0) ? "+" : "-";

   CriarTexto("t_lbl_sessao", x_col1, L1, "SESSÃO", Cor_Header, 8, "Trebuchet MS");
   CriarTexto("t_val_cap", x_col1, L2, "$ " + DoubleToString(cap_atual, 2), Cor_Texto, 10, "Arial Bold");
   CriarTexto("t_val_res", x_col1, L3, s_res + "$" + DoubleToString(MathAbs(res_sessao), 2) + " (" + s_res + DoubleToString(MathAbs(pct_sessao), 2) + "%)", c_res, 9, "Trebuchet MS");
   CriarTexto("t_stop", x_col1, L4, "SL:$" + DoubleToString(Stop_Loss_Financeiro, 0) + " R:" + IntegerToString(contador_resets), Cor_Texto_Sec, 8, "Trebuchet MS");

   // --- BLOCO GRID DE COMPRA ---
   int buys = ContarOrdens(POSITION_TYPE_BUY);
   int sells = ContarOrdens(POSITION_TYPE_SELL);

   CriarTexto("t_lbl_buy", x_col2, L1, "GRID COMPRA", Cor_Header, 8, "Trebuchet MS");
   CriarTexto("t_val_buy", x_col2, L2, "Ordens: " + IntegerToString(buys), Cor_Texto, 10, "Arial Bold");
   string status_b = (sells > 0) ? "Bloqueado" : "Operando";
   color cor_sb = (sells > 0) ? Cor_Negativo : Cor_Positivo;
   CriarTexto("t_val_buy_st", x_col2, L3, "Status: " + status_b, cor_sb, 9, "Trebuchet MS");

   // --- BLOCO GRID DE VENDA ---
   CriarTexto("t_lbl_sell", x_col3, L1, "GRID VENDA", Cor_Header, 8, "Trebuchet MS");
   CriarTexto("t_val_sell", x_col3, L2, "Ordens: " + IntegerToString(sells) + "/" + IntegerToString(Max_Vendas), Cor_Texto, 10, "Arial Bold");
   string status_s = (!primeira_compra_aberta) ? "Aguard. compra" : (sells >= Max_Vendas ? "Máx. atingido" : "Operando");
   color cor_ss = (!primeira_compra_aberta || sells >= Max_Vendas) ? Cor_Texto_Sec : Cor_Positivo;
   CriarTexto("t_val_sell_st", x_col3, L3, "Status: " + status_s, cor_ss, 9, "Trebuchet MS");

   // --- BLOCO OPERAÇÃO (Tempo ativo / Total de ordens) ---
   string tempo_ativo = FormatarTempo((int)(TimeCurrent() - hora_inicio_sessao));
   CriarTexto("t_lbl_op", x_col4, L1, "OPERAÇÃO", Cor_Header, 8, "Trebuchet MS");
   CriarTexto("t_val_tempo", x_col4, L2, tempo_ativo, Cor_Texto, 10, "Arial Bold");
   CriarTexto("t_val_totord", x_col4, L3, "Total Ordens: " + IntegerToString(buys + sells), Cor_Texto_Sec, 9, "Trebuchet MS");

   // --- BLOCO MERCADO (Spread / Margem) ---
   int spread_pts = (int)SymbolInfoInteger(_Symbol, SYMBOL_SPREAD);
   double margem_nivel = AccountInfoDouble(ACCOUNT_MARGIN_LEVEL);
   string s_margem = (margem_nivel > 0) ? DoubleToString(margem_nivel, 2) + "%" : "—";

   CriarTexto("t_lbl_merc", x_col5, L1, "MERCADO", Cor_Header, 8, "Trebuchet MS");
   CriarTexto("t_val_spread", x_col5, L2, "Spread: " + IntegerToString(spread_pts) + " pts", Cor_Texto, 10, "Arial Bold");
   CriarTexto("t_val_margem", x_col5, L3, "Margem: " + s_margem, Cor_Texto_Sec, 9, "Trebuchet MS");

   // --- BLOCO PREÇO MÉDIO (Compra / Venda) ---
   int digits = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   double pmc = CalcularPrecoMedio(POSITION_TYPE_BUY);
   double pmv = CalcularPrecoMedio(POSITION_TYPE_SELL);
   string s_pmc = (pmc > 0) ? DoubleToString(pmc, digits) : "—";
   string s_pmv = (pmv > 0) ? DoubleToString(pmv, digits) : "—";

   CriarTexto("t_lbl_pm", x_col6, L1, "PREÇO MÉDIO", Cor_Header, 8, "Trebuchet MS");
   CriarTexto("t_val_pmc", x_col6, L2, "Compra: " + s_pmc, Cor_Texto, 9, "Arial Bold");
   CriarTexto("t_val_pmv", x_col6, L3, "Venda: " + s_pmv, Cor_Texto, 9, "Arial Bold");

   // --- BLOCO FLUTUANTE (destaque, com botão de reset acima) ---
   double lucro_flut = CalcularLucroEA();
   color c_flut = (lucro_flut >= 0) ? Cor_Positivo : Cor_Negativo;
   string s_flut = (lucro_flut >= 0) ? "+" : "-";

   CriarTexto("t_lbl_flut", x_flut, y + 58, "FLUTUANTE", Cor_Texto_Sec, 8, "Trebuchet MS");
   CriarTexto("t_val_flut", x_flut, y + 78, s_flut + "$ " + DoubleToString(MathAbs(lucro_flut), 2), c_flut, 16, "Arial Black");

   ChartRedraw(0);
}

void DeletarTodosObjetos()
{
   // Remove os elementos gráficos com o prefixo criado para eles
   ObjectsDeleteAll(0, "p_");
   ObjectsDeleteAll(0, "t_");
   ObjectDelete(0, "btn_reset");

   ChartRedraw();
}
